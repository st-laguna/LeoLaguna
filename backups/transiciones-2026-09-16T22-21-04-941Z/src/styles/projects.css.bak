.projects {--project-sidebar:clamp(125px,12vw,180px);--media-gap:clamp(64px,4.5vw,88px);position:relative;isolation:isolate;color:var(--foreground);background:var(--background);scroll-margin-top:0;}
.projects *, .gallery-dialog *, .project-lightbox * {box-sizing:border-box;}
.projects [hidden],.gallery-dialog [hidden] {display:none!important;}
.projects button,.projects a,.gallery-dialog button,.project-lightbox button {font:inherit;color:inherit;}
.projects button:focus-visible,.projects a:focus-visible,.gallery-dialog button:focus-visible,.project-lightbox button:focus-visible {outline:2px solid var(--accent);outline-offset:4px;}
.projects-stage {position:relative;display:grid;grid-template-columns:var(--project-sidebar) minmax(0,1fr);background:var(--background);transition:background-color .45s ease;color:var(--foreground);overflow:hidden;}
.projects-sidebar {position:relative;z-index:1;display:flex;flex-direction:column;justify-content:space-between;padding:var(--media-gap) 16px;background:var(--surface);}
.projects-mark {width:44px;height:28px;display:block;}
.projects-mark span {display:block;width:100%;height:100%;background:currentColor;mask:url('/icons/logo_w.svg') center/contain no-repeat;-webkit-mask:url('/icons/logo_w.svg') center/contain no-repeat;}
.projects-vertical {display:flex;flex-direction:column;gap:clamp(28px,6vh,65px);align-items:flex-start;font-size:10px;font-weight:700;}
.projects-vertical span {writing-mode:vertical-rl;transform:rotate(180deg);}
.projects-sidebar nav {display:grid;gap:8px;font-size:clamp(12px,1vw,16px);font-weight:700;}
.projects-sidebar nav a {position:relative;padding-left:15px;text-decoration:none;}
.projects-sidebar nav a::before {content:'';position:absolute;left:0;top:50%;width:6px;height:6px;background:#ff8a00;border-radius:50%;transform:translateY(-50%);visibility:hidden;}
.projects-sidebar nav a:hover::before,.projects-sidebar nav a:focus-visible::before {visibility:visible;}
.projects-main {min-width:0;position:relative;}
.projects-window {min-width:0;overflow:hidden;}
.projects-rail {display:flex;flex-direction:column;}
.project-panel {position:relative;min-width:0;flex-shrink:0;padding:var(--media-gap);display:grid;grid-template-columns:minmax(0,1fr) minmax(120px,28%);gap:var(--media-gap);align-items:start;}
.project-media {position:relative;aspect-ratio:1.75;min-height:0;border-radius:18px;overflow:hidden;background:var(--surface);}
.project-slide {position:absolute;inset:0;margin:0;}
.project-enlarge {display:block;width:100%;height:100%;padding:0;border:0;background:none;cursor:zoom-in;}
.project-enlarge img,.project-slide>video {display:block;width:100%;height:100%;object-fit:cover;}
.project-slide>video {object-fit:contain;background:#000;}
.project-slide figcaption {position:absolute;right:14px;bottom:14px;max-width:min(350px,60%);padding:12px 14px;background:#0009;backdrop-filter:blur(8px);color:#fff;border-radius:8px;text-align:right;pointer-events:none;}
.project-slide figcaption strong {display:block;font-size:13px;}
.project-slide figcaption span {display:block;font-size:10px;line-height:1.3;margin-top:4px;}
.project-panel--video figcaption {bottom:58px;}
.project-thumbs {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(7px,1vw,16px);align-content:start;min-width:0;}
.project-thumbs button {display:block;aspect-ratio:1;min-width:0;width:100%;padding:0;border:0;background:var(--surface);border-radius:6px;overflow:hidden;transition:translate 300ms ease;}
.project-thumbs button[aria-pressed="true"] {outline:2px solid currentColor;outline-offset:3px;}
.project-thumbs button:hover:not(:disabled) {translate:0 -4px;}
.project-thumbs img {display:block;width:100%;height:100%;object-fit:cover;}
.project-thumbs button:disabled {cursor:default;border:1px dashed #8886;color:#888;}
.project-video-label {display:grid;place-content:center;gap:8px;font-size:24px;}
.project-video-label small {font-size:10px;}
.project-panel--video .project-thumbs {grid-template-columns:1fr;width:clamp(60px,8vw,110px);justify-self:end;}
.project-mobile-copy {grid-column:1/-1;margin:15px 0 55px;}
.project-mobile-copy>span {font-size:65px;font-weight:800;}
.project-mobile-copy h3 {max-width:480px;margin:10px 0;font-size:32px;line-height:1.05;}
.project-mobile-copy p {max-width:500px;font-size:13px;line-height:1.4;text-transform:uppercase;}
.project-mobile-copy button {border:0;background:none;padding:16px 0;font-weight:700;}
.projects-footer,.projects-progress {display:none;}
/* El recorrido tiene pausas; su duración se configura en projects.ts. */
.projects[data-horizontal] {height:880svh;}
.projects[data-horizontal] .projects-stage {height:100svh;position:sticky;top:0;}
.projects[data-horizontal] .projects-main {display:grid;grid-template-rows:minmax(0,1fr) clamp(225px,34svh,340px) 3px;}
.projects[data-horizontal] .projects-window,.projects[data-horizontal] .projects-rail {height:100%;}
.projects[data-horizontal] .projects-rail {flex-direction:row;will-change:transform;}
.projects[data-horizontal] .project-panel {width:100%;height:100%;align-items:stretch;grid-template-columns:minmax(0,1fr) minmax(170px,28%);}
.projects[data-horizontal] .project-media {aspect-ratio:auto;}
.projects[data-horizontal] .project-thumbs {width:min(100%,calc(66svh - 2 * var(--media-gap)));justify-self:end;}
.projects[data-horizontal] .project-panel--video .project-thumbs {width:min(100%,calc((66svh - 2 * var(--media-gap) - 32px) / 3));}
.projects[data-horizontal] .project-mobile-copy {display:none;}
.projects[data-horizontal] .projects-footer {display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:clamp(22px,2.5vw,48px);align-items:center;min-width:0;padding:var(--media-gap);padding-top:calc(var(--media-gap) * 1.2);}
.projects-number {display:flex;font-family:'Archivo','Host Grotesk',sans-serif;font-weight:800;font-size:clamp(85px,11vw,175px);letter-spacing:-.075em;line-height:1;}
.projects-digit-window {height:1em;overflow:hidden;padding-right:.06em;}
.projects-digits {display:flex;flex-direction:column;}
.projects-digits>span {display:block;height:1em;flex-shrink:0;}
.projects-copy-stack {display:grid;overflow:hidden;min-width:0;}
.projects-copy {grid-area:1/1;min-width:0;}
.projects-copy h2 {max-width:650px;font-size:clamp(27px,3.2vw,55px);font-weight:800;line-height:1.04;letter-spacing:-.045em;margin:0 0 14px;text-transform:uppercase;}
.projects-copy p {max-width:480px;font-size:clamp(10px,.86vw,14px);line-height:1.35;margin:0;text-transform:uppercase;}
.projects-actions {height:100%;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end;}
.projects-paging {display:flex;gap:10px;}
.projects-paging button {width:34px;height:34px;border:1px solid #8886;border-radius:50%;background:none;}
.projects-paging button:disabled {color:#777;cursor:default;}
.projects-view-all {border:0;background:none;padding:12px 0;font-size:12px!important;font-weight:700!important;white-space:nowrap;}
.projects[data-horizontal] .projects-progress {display:block;height:3px;background:#8883;overflow:hidden;}
.projects-progress>span {display:block;width:0;height:100%;background:var(--foreground);}
/* Galería modal: scroll exclusivo y masonry de alturas naturales. */
.gallery-dialog {position:fixed;inset:0;width:100%;max-width:none;height:100dvh;max-height:none;margin:0;border:0;padding:0;background:transparent;color:var(--foreground);overscroll-behavior:none;overflow:hidden;}
.gallery-dialog::backdrop {background:transparent;}
.gallery-shell {height:100%;display:grid;grid-template-rows:auto minmax(0,1fr);background:var(--background);}
.gallery-header {display:flex;align-items:center;justify-content:space-between;gap:24px;padding:clamp(24px,4vw,64px);border-bottom:1px solid #8884;}
.gallery-header h2 {margin:0;font-size:clamp(24px,3vw,50px);line-height:1.1;}
.gallery-header button {border:0;background:none;font-weight:700;white-space:nowrap;font-size:12px;}
.gallery-scroll {overflow-y:auto;overscroll-behavior:contain;padding:clamp(24px,4vw,64px);scrollbar-gutter:stable;}
.gallery-masonry {columns:3;column-gap:clamp(18px,2vw,36px);}
.gallery-item {break-inside:avoid;display:inline-block;width:100%;margin:0 0 clamp(18px,2vw,36px);vertical-align:top;}
.gallery-item button {display:block;padding:0;width:100%;border:0;background:none;cursor:zoom-in;overflow:hidden;border-radius:12px;}
.gallery-item img,.gallery-item video {display:block;width:100%;height:auto;border-radius:12px;}
.gallery-item figcaption {margin-top:8px;font-size:11px;}
.project-lightbox {position:fixed;inset:0;width:100%;max-width:none;height:100dvh;max-height:none;margin:0;padding:70px 5vw 40px;border:0;background:transparent;color:#fff;overflow:hidden;}
.project-lightbox[open] {display:grid;place-items:center;}
.project-lightbox::backdrop {background:#000c;backdrop-filter:blur(16px);}
.lightbox-figure {margin:0;max-width:90vw;max-height:85dvh;display:grid;justify-items:center;gap:12px;}
.lightbox-figure img {display:block;max-width:90vw;max-height:78dvh;width:auto;height:auto;object-fit:contain;}
.lightbox-figure figcaption {font-size:12px;}
.lightbox-close {position:absolute;right:5vw;top:24px;border:1px solid #fff5;border-radius:999px;background:#000;color:#fff;padding:10px 18px;z-index:1;}
@media(max-width:1000px),(max-height:680px){
 .projects{--media-gap:24px;}.projects-stage{grid-template-columns:1fr;}
 .projects-sidebar{display:none;}
 .project-panel{grid-template-columns:minmax(0,1fr) 30%;padding-top:60px;}
 .project-media{aspect-ratio:1.4;}
 .project-slide figcaption{max-width:85%;padding:8px;}
 .project-slide figcaption span{font-size:9px;}
 .project-thumbs{gap:7px;}
 .project-panel--video .project-thumbs{width:60px;}
 .gallery-masonry{columns:2;}
}
@media(max-width:600px){
 .project-panel{grid-template-columns:1fr;gap:24px;padding-top:85px;}
 .project-media{aspect-ratio:1.35;}
 .project-thumbs{grid-template-columns:repeat(3,minmax(0,1fr));}
 .project-panel--video .project-thumbs{width:100%;grid-template-columns:repeat(3,minmax(0,1fr));}
 .project-mobile-copy{margin-top:12px;}
 .gallery-masonry{columns:1;}
 .gallery-header{align-items:flex-start;flex-direction:column;gap:14px;}
}
@media(prefers-reduced-motion:reduce){.projects *{transition:none!important;}.projects{--media-gap:24px;}.projects-stage{grid-template-columns:1fr;}.projects-sidebar{display:none;}}
/* Misma altura para la imagen y la cuadrícula 3 × 3 */
.projects[data-horizontal]
.project-panel:not(.project-panel--video) {
  --gallery-height: calc(
    100svh
    - clamp(225px, 34svh, 340px)
    - 3px
    - var(--media-gap)
    - var(--media-gap)
  );

  grid-template-columns: minmax(0, 1fr) var(--gallery-height);
  align-items: stretch;
}

.projects[data-horizontal]
.project-panel:not(.project-panel--video) .project-thumbs {
  width: 100%;
  height: 100%;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-template-rows: repeat(3, minmax(0, 1fr));
}

.projects[data-horizontal]
.project-panel:not(.project-panel--video) .project-thumbs button {
  width: 100%;
  height: 100%;
  aspect-ratio: auto;
}