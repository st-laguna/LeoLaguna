/* Sección independiente: no modifica Hero ni Workflow. */
.projects { --project-sidebar: clamp(100px,11vw,155px); color:var(--foreground,#000); background:var(--background,#f7f7f7); position:relative; scroll-margin-top:0; }
.projects *, .projects *::before, .projects *::after {box-sizing:border-box}
.projects [hidden] {display:none!important}
.projects button,.projects a {color:inherit;font:inherit}
.projects button {cursor:pointer}
.projects button:focus-visible,.projects a:focus-visible {outline:2px solid currentColor;outline-offset:5px}
.projects-stage {position:relative;display:grid;grid-template-columns:var(--project-sidebar) minmax(0,1fr);background:var(--background,#f7f7f7);transition:background-color .45s ease,color .45s ease}
.projects-sidebar {padding:22px 18px;display:flex;flex-direction:column;justify-content:space-between;background:var(--surface,#efefef);transition:background-color .45s ease}
.projects-mark {display:block;width:44px;height:28px}
.projects-mark span {display:block;width:100%;height:100%;background:currentColor;mask:url('/icons/logo_w.svg') center/contain no-repeat;-webkit-mask:url('/icons/logo_w.svg') center/contain no-repeat}
.projects-vertical {display:flex;flex-direction:column;gap:65px;align-items:flex-start;font-size:10px;font-weight:700}
.projects-vertical span {writing-mode:vertical-rl;transform:rotate(180deg)}
.projects-sidebar nav {display:grid;gap:5px;font-size:15px;font-weight:700}
.projects-sidebar a {text-decoration:none}
.projects-sidebar [aria-current]::before {content:'';display:inline-block;width:6px;height:6px;margin:0 7px 2px 0;background:#ff8a00;border-radius:50%}
.projects-main {min-width:0;position:relative}
.projects-window {overflow:hidden;min-width:0}
.projects-rail {display:flex;flex-direction:column}
.project-panel {min-width:0;position:relative;padding:20px 20px 0;flex-shrink:0}
.project-media {position:relative;aspect-ratio:2.85;min-height:0;border-radius:19px;overflow:hidden;background:var(--surface,#efefef)}
.project-slide {position:absolute;inset:0;margin:0}
.project-slide>img,.project-slide>video {width:100%;height:100%;display:block;object-fit:cover}
.project-slide>video {object-fit:contain;background:#000}
.project-slide figcaption {position:absolute;right:16px;bottom:16px;max-width:min(390px,55%);padding:12px 16px;background:#0008;color:#fff;border-radius:8px;text-align:right;pointer-events:none;backdrop-filter:blur(8px)}
.project-slide figcaption strong {display:block;font-size:13px}
.project-slide figcaption span {display:block;font-size:10px;line-height:1.3;margin-top:4px}
.project-panel--video figcaption {bottom:60px}
.project-thumbs {display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px;padding:16px 0}
.project-thumbs button {padding:0;border:0;background:var(--surface,#efefef);min-width:0;aspect-ratio:1.9;position:relative;border-radius:3px;transition:transform .2s ease,opacity .2s ease;opacity:.65}
.project-thumbs button[aria-pressed="true"] {opacity:1;outline:2px solid var(--foreground,#000);outline-offset:3px}
.project-thumbs button:hover:not(:disabled) {transform:scale(1.06);z-index:2;opacity:1}
.project-thumbs img {display:block;width:100%;height:100%;object-fit:cover;border-radius:3px}
.project-thumbs button:disabled {cursor:default;border:1px dashed #8886;opacity:.35}
.project-video-label {display:grid;place-content:center;gap:7px;font-size:22px}
.project-video-label small {font-size:9px}
.project-panel--video {display:grid;grid-template-columns:minmax(0,1fr) 105px;gap:16px}
.project-panel--video .project-thumbs {grid-template-columns:1fr;grid-template-rows:repeat(3,minmax(0,1fr));padding:0}
.project-panel--video .project-thumbs button {aspect-ratio:auto}
.project-panel--video .project-mobile-copy {grid-column:1/-1}
.project-mobile-copy {padding:26px 0 55px}
.project-mobile-copy>span {font-size:60px;font-weight:800}
.project-mobile-copy h3 {font-size:30px;line-height:1;max-width:450px;margin:8px 0}
.project-mobile-copy p {max-width:500px;font-size:13px;line-height:1.4;text-transform:uppercase}
.project-mobile-copy button,.projects-expanded button {border:0;border-bottom:1px solid currentColor;background:none;padding:8px 0;font-weight:700}
.projects-footer,.projects-progress {display:none}
.projects-expanded {padding:50px max(6vw,24px) 80px;scroll-margin-top:100px}
.projects-expanded-heading {display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:30px}
.projects-expanded-heading h2 {font-size:clamp(25px,4vw,50px);margin:0}
.projects-gallery {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px}
.projects-gallery figure {margin:0;min-width:0}
.projects-gallery img,.projects-gallery video {display:block;width:100%;height:auto;border-radius:14px;background:var(--surface,#eee)}
.projects-gallery figcaption {font-size:11px;margin-top:8px}
/* Activado por JS únicamente cuando hay espacio y no se solicita movimiento reducido. */
.projects[data-horizontal] {height:420svh}
.projects[data-horizontal] .projects-stage {height:100svh;position:sticky;top:0}
.projects[data-horizontal] .projects-main {display:grid;grid-template-rows:minmax(0,1fr) clamp(160px,27svh,245px) 3px}
.projects[data-horizontal] .projects-window,.projects[data-horizontal] .projects-rail {height:100%}
.projects[data-horizontal] .projects-rail {flex-direction:row;will-change:transform}
.projects[data-horizontal] .project-panel {width:100%;height:100%;display:grid;grid-template-rows:minmax(0,1fr) clamp(65px,13svh,115px);padding-top:64px}
.projects[data-horizontal] .project-media {aspect-ratio:auto}
.projects[data-horizontal] .project-thumbs {min-height:0}
.projects[data-horizontal] .project-thumbs button {aspect-ratio:auto;min-height:0}
.projects[data-horizontal] .project-panel--video {grid-template-rows:minmax(0,1fr);padding-bottom:16px}
.projects[data-horizontal] .project-panel--video .project-thumbs {grid-template-rows:repeat(3,minmax(0,1fr))}
.projects[data-horizontal] .project-mobile-copy {display:none}
.projects[data-horizontal] .projects-footer {display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:24px;align-items:center;padding:16px 24px 22px;border-top:1px solid #8883;min-width:0}
.projects-number {display:flex;font-family:'Archivo','Host Grotesk',sans-serif;font-weight:800;font-size:clamp(90px,12vw,190px);letter-spacing:-.075em;line-height:1}
.projects-digit-window {display:block;height:1em;overflow:hidden;padding-right:.06em}
.projects-digits {display:flex;flex-direction:column;will-change:transform}
.projects-digits>span {height:1em;display:block;flex-shrink:0}
.projects-copy-stack {display:grid;min-width:0}
.projects-copy {grid-area:1/1;min-width:0}
.projects-copy h2 {max-width:550px;font-size:clamp(27px,3.65vw,60px);font-weight:800;line-height:1.03;letter-spacing:-.045em;margin:0 0 9px;text-transform:uppercase}
.projects-copy p {max-width:450px;font-size:clamp(10px,.8vw,13px);line-height:1.3;margin:0;text-transform:uppercase}
.projects-actions {height:100%;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end;padding-top:8px}
.projects-paging {display:flex;gap:12px}
.projects-paging button {border:1px solid #8886;background:none;border-radius:50%;width:32px;height:32px}
.projects-view-all {background:none;border:0;padding:12px 0;font-size:12px!important;font-weight:700!important;white-space:nowrap}
.projects[data-horizontal] .projects-progress {display:block;height:3px;background:#8883;overflow:hidden}
.projects-progress>span {display:block;width:100%;height:100%;background:var(--foreground,#000);transform-origin:left;transform:scaleX(0)}
html.projects-active .site-nav {visibility:hidden;pointer-events:none}
/* View All: el mismo escenario sale del sticky y se abre el flujo vertical. */
.projects[data-expanded] {height:auto}
.projects[data-expanded] .projects-stage {position:relative}
.projects[data-expanded] .projects-rail {transform:none!important}
.projects[data-expanded] .project-panel:not([data-selected-panel]) {display:none!important}

@media(max-width:900px),(max-height:620px) {
 .projects-stage {grid-template-columns:1fr}
 .projects-sidebar {display:none}
 .project-panel {padding-top:32px}
 .project-media {aspect-ratio:1.65}
 .project-slide figcaption {max-width:75%;padding:8px}
 .project-slide figcaption span {font-size:9px}
 .projects-gallery {grid-template-columns:1fr}
 .project-panel--video {grid-template-columns:minmax(0,1fr) 65px;gap:8px}
 .project-thumbs {gap:6px}
}
@media(prefers-reduced-motion:reduce) {.projects * {transition:none!important;scroll-behavior:auto!important}}
