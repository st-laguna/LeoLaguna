@import "tailwindcss";

@theme {
  --font-sans: "Host Grotesk", Arial, sans-serif;
}

:root {
  color-scheme: light;
  --background: #f7f7f7;
  --foreground: #000000;
  --surface: #efefef;
  --accent: #ff6b00;
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --background: #000000;
  --foreground: #f7f7f7;
  --surface: #222222;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans);
}

img,
video {
  display: block;
  max-width: 100%;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 5px;
}

::selection {
  background: var(--accent);
  color: #000000;
}

@font-face {
  font-family: "Host Grotesk";
  src: url("/fonts/HostGrotesk.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Archivo";
  src: url("/fonts/Archivo.woff2") format("woff2");
  font-weight: 800;
  font-style: normal;
  font-display: swap;
}
body,
.hero {
  transition:
    background-color 450ms ease-in-out,
    color 450ms ease-in-out;
}

@media (prefers-reduced-motion: reduce) {
  body,
  .hero {
    transition: none;
  }
}

.site-header {
  display: contents;
}

.site-nav {
  position: fixed;
  top: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(28px, 6vw, 100px);
  min-height: 36px;
  width: max-content;

  color: #fff;
  mix-blend-mode: difference;
  pointer-events: auto;
}

.site-nav a {
  padding-block: 8px;
  color: inherit;
  text-decoration: none;
  white-space: nowrap;
  font-size: clamp(11px, 0.95vw, 15px);
}

.site-nav a:hover {
  text-decoration: underline;
  text-underline-offset: 6px;
}

.site-header .site-controls {
  position: fixed;
  top: 24px;
  right: var(--page-gap, 3.2vw);
  left: auto;
  z-index: 51;
  mix-blend-mode: normal;
  pointer-events: auto;
}

@media (max-width: 900px) {
  .site-nav {
    top: 70px;
    gap: 28px;
  }

  .site-header .site-controls {
    top: 16px;
  }
}

@media (max-width: 640px) {
  .site-header .site-controls {
    right: var(--page-gap, 6vw);
  }
}