{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "leo-laguna-contact",
  "main": "index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "CONTACT_FROM": "forms@leolaguna.com" },
  "send_email": [{ "name": "EMAIL", "destination_address": "sanchezlaguna99@gmail.com" }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
  // Internal only: Pages calls this Worker through CONTACT_WORKER. No routes.
  // TURNSTILE_SECRET_KEY is a Worker secret: never put it in vars or frontend code.
}
