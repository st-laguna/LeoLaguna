---
import {responsiveWorkImage} from '../data/responsive-work-image';
import {serviceThumbnail} from '../data/service-thumbnail';
import { projects, projectAssetLabel } from '../data/projects';
import { projectImageSize } from '../data/project-image-size';
import en from '../i18n/en.json';
import '../styles/projects.css';
import GlassSidebar from './GlassSidebar.astro';
import ServiceStickyGrid from './ServiceStickyGrid.astro';
import GalleryFooter from './GalleryFooter.astro';
import AnimationVideoPlayer from './AnimationVideoPlayer.astro';
import NavigationMenu from './NavigationMenu.astro';
import '../styles/gallery-mobile-controls.css';


const t = en as Record<string,string>;
const responsiveImages=new Map(await Promise.all(projects.flatMap(project=>project.assets.filter(asset=>asset.kind==='image')).map(async asset=>[asset.src,await responsiveWorkImage(asset.src)] as const)));
---
<section id="work" class="projects" aria-label="Projects" data-projects data-featured-handoff>
  <div class="projects-stage">
  <GlassSidebar />
    <div class="projects-main">
      <!-- Una retícula por proyecto; recorre el mismo desplazamiento que las imágenes. -->
      <div class="projects-guides" aria-hidden="true">
        <div class="projects-guides-rail">
          {projects.map((project) => (
            <div class="project-guide-page" data-guide-page={project.id}>
              {[1,2,3,4].map(n => <span class={`project-guide project-guide--h project-guide--h${n}`} />)}
              {[1,2,3].map(n => <span class={`project-guide project-guide--v project-guide--v${n}`} />)}
            </div>
          ))}
        </div>
      </div>
      <div class="projects-window">
        <div class="projects-rail">
          {projects.map((project,index) => (
            <article class:list={['project-panel', {'project-panel--video':index===3}]} data-panel={index}>
              <div class="project-media">
                {project.assets.map((asset,j) => (
                  <figure class="project-slide" data-slide={j} hidden={j!==0}>
                    {asset.kind === 'image' ? (
                      <button class="project-enlarge" type="button" data-zoom-src={asset.src} data-zoom-alt={projectAssetLabel(asset, project)} aria-label={`Ampliar / Enlarge: ${projectAssetLabel(asset, project)}`}><img data-src={asset.src} data-srcset={responsiveImages.get(asset.src)?.srcset} sizes="(max-width:1400px) 100vw, 70vw" {...projectImageSize(asset.src)} alt={projectAssetLabel(asset, project)} loading="lazy" decoding="async" /></button>
                    ) : (
                      <video data-auto-video width={asset.width || 1920} height={asset.height || 1080} style={`--video-aspect:${asset.width || 1920}/${asset.height || 1080}`} src={asset.src} poster={asset.poster || asset.src.replace('/videos/', '/videos/mini/').replace(/\.webm$/i, '.webp')} muted loop playsinline preload="none" aria-label={projectAssetLabel(asset, project)} ></video>
                    )}
                  </figure>
                ))}
              </div>
              <div class="project-mobile-controls">
                <div class="project-thumbs" role="tablist" aria-label={`${t[`projects.${project.id}.title`]} gallery`}>
                  {project.assets.map((asset,j) => (
                    <button type="button" role="tab" data-select={j} data-index={j} aria-selected={j===0} tabindex={j===0 ? 0 : -1} aria-label={`View: ${projectAssetLabel(asset, project)}`}>
                      {/* Beyond these desktop limits, controls only appear as image-free mobile dots. */}
                      {j < (asset.kind === 'video' ? 8 : 9) && (
                        <img data-src={serviceThumbnail(asset,320)} data-srcset={`${serviceThumbnail(asset,320)} 320w, ${serviceThumbnail(asset,640)} 640w`} sizes="(min-width:1001px) min(10vw,220px), 120px" width="320" height="320" alt="" loading="lazy" decoding="async" />
                      )}
                    </button>
                  ))}
                </div>
                <button type="button" class="project-mobile-more" data-open={index} aria-label={t['projects.viewAll']}><span data-roll-label data-i18n="projects.viewAll">{t['projects.viewAll']}</span><span class="action-arrow" data-direction="diagonal" aria-hidden="true"><span data-arrow="↗">↗</span></span></button>
              </div>
              <div class="project-mobile-copy">
                <span><button type="button" class="project-panel-back" data-panel-back disabled tabindex="-1" aria-label={`${project.id} — Volver / Back to ${t[`projects.${project.id}.title`]}`}><span>{project.id.slice(0,1)}</span><span>{project.id.slice(1)}</span></button></span>
                <h2 data-i18n={`projects.${project.id}.title`}>{t[`projects.${project.id}.title`]}</h2>
                <p data-i18n={`projects.${project.id}.description`}>{t[`projects.${project.id}.description`]}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="service-gallery-controls" aria-label="Service gallery">
        <div class="service-dots">{Array.from({length:6},(_,i)=><button type="button" data-service-dot={i} aria-label={"View image "+(i+1)} aria-pressed={i===0?'true':'false'}><span><i></i></span></button>)}</div>
        <button type="button" class="service-play" aria-label="Play gallery"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 2.5v13l11-6.5z" fill="currentColor"/></svg></button>
      </div>
      <div class="projects-footer">
        <nav class="service-preview-nav" aria-label="Service previews" data-i18n-aria-label="projects.previewNavigation">
          <div class="service-preview-progress" aria-hidden="true"><span></span></div>
          {[1,2,3,4].map((n)=><button type="button" data-service-preview={n-1} aria-label={`Service 0${n}`} aria-pressed={n===1?'true':'false'}>
            {n===4?<video data-service-preview-video poster="/videos/mini/havida.webp" data-src="/img/service-thumbs/a_mini4.webm" muted loop playsinline preload="metadata" />:<img src={`/img/service-thumbs/a_mini${n}.webp`} alt="" loading="lazy" />}
          </button>)}
        </nav>
        <div class="projects-number" aria-hidden="true"><span>0</span><span class="projects-digit-window"><span class="projects-digits"><span>1</span><span>2</span><span>3</span><span>4</span></span></span></div>
        <div class="projects-copy-stack">
          {projects.map((project,index)=>(
            <div class="projects-copy" data-copy={index}>
              <h2 data-i18n={`projects.${project.id}.title`}>{t[`projects.${project.id}.title`]}</h2>
              <p data-i18n={`projects.${project.id}.description`}>{t[`projects.${project.id}.description`]}</p>
            </div>
          ))}
        </div>
        <div class="projects-actions">
          <div class="projects-paging">
            <button type="button" data-step="-1" aria-label="Previous / Anterior"><span class="action-arrow" data-direction="left" aria-hidden="true"><span data-arrow="←">←</span></span></button>
            <button type="button" data-step="1" aria-label="Next / Siguiente"><span class="action-arrow" data-direction="right" aria-hidden="true"><span data-arrow="→">→</span></span></button>
          </div>
          <button type="button" class="projects-view-all action-pill" data-open="current" aria-controls="projects-expanded" aria-expanded="false"><span data-roll-label data-i18n="projects.viewAll">{t['projects.viewAll']}</span> <span class="action-arrow" data-direction="diagonal" aria-hidden="true"><span data-arrow="↗">↗</span></span></button>
        </div>
      </div>
      <div class="projects-progress" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>
<dialog id="projects-expanded" class="gallery-dialog" aria-labelledby="gallery-heading">
  <div class="gallery-menu">
    <NavigationMenu context="site" id="gallery-navigation" preferences links={[
      {label:'Services',href:'/#work',i18n:'nav.services'},
      {label:'About',href:'/about/',i18n:'nav.about'},
      {label:'Works',href:'/#featured-works',i18n:'nav.works'},
    ]} />
  </div>
  <div class="gallery-shell">
    <header class="gallery-header">
      <h2 id="gallery-heading" data-i18n="projects.gallery">{t['projects.gallery']}</h2>
      <span class="gallery-return-motion"><span class="gallery-return-entry"><button type="button" class="action-pill" data-gallery-close aria-label="Back to projects / Volver a proyectos"><span data-roll-label data-i18n="projects.close">{t['projects.close']}</span> <span class="action-arrow" data-direction="up" aria-hidden="true"><span data-arrow="↑">↑</span></span></button></span></span>
    </header>
    <div class="gallery-scroll" tabindex="0" aria-label="Project gallery / Galería de proyectos">
      {projects.map((project,index)=>(
        <div class="service-gallery" data-gallery={index} hidden>
          {index !== 3 && <ServiceStickyGrid project={project} />}
          {index === 3 && <div class="service-video-intro">
            <span class="service-intro-number" data-service-number>{project.id}</span>
            <span class="service-grid-eyebrow" data-sticky-eyebrow data-i18n="projects.gallery">{t['projects.gallery']}</span>
            <h2 class="service-grid-title" data-sticky-title data-i18n={`projects.${project.id}.title`}>{t[`projects.${project.id}.title`]}</h2>
            <span class="service-grid-scroll-hint" data-sticky-hint data-i18n="projects.scrollHint">{t['projects.scrollHint']}</span>
          </div>}

          <div class:list={["gallery-masonry", {"service-gallery-list": index !== 3}]}>
          {index !== 3 && [0,1,2].map(i=><div class="service-gallery-lead-slot" data-service-lead={i} hidden></div>)}
          {project.assets.map((asset,assetIndex)=>(
            <figure class="gallery-item" data-phone-gallery-item={index !== 3 && assetIndex < 6}>
              {asset.kind==='image' ? (
                <button type="button" data-zoom-src={asset.src} data-zoom-alt={projectAssetLabel(asset, project)} aria-label={`Ampliar / Enlarge: ${projectAssetLabel(asset, project)}`}>
                  <img data-src={asset.src} data-srcset={responsiveImages.get(asset.src)?.srcset} sizes="(max-width:1400px) 50vw, 45vw" {...projectImageSize(asset.src)} alt={projectAssetLabel(asset, project)} loading="lazy" decoding="async" />
                </button>
              ) : <video data-auto-video width={asset.width || 1920} height={asset.height || 1080} style={`--video-aspect:${asset.width || 1920}/${asset.height || 1080}`} src={asset.src} poster={asset.poster || asset.src.replace('/videos/', '/videos/mini/').replace(/\.webm$/i, '.webp')} muted loop playsinline preload="none" aria-label={projectAssetLabel(asset, project)} ></video>}
              {asset.client && <figcaption>{asset.client}</figcaption>}
            </figure>
          ))}
          </div>
          {index === 3 && <><AnimationVideoPlayer project={project} /><AnimationVideoPlayer project={project} desktop /></>}
          <GalleryFooter />
        </div>
      ))}
    </div>
  </div>
</dialog>
<dialog class="project-lightbox" aria-label="Vista ampliada / Enlarged image">
  <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close image / Cerrar imagen"><span aria-hidden="true">×</span></button>
  <figure class="lightbox-figure"><img data-lightbox-image alt="" /></figure>
</dialog>
<script>
  import '../scripts/projects';
  import '../scripts/project-videos';
  import '../scripts/service-preview-nav';
</script>
