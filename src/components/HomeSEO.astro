---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const origin = 'https://leolaguna.com/';
const url = new URL(Astro.url.pathname, origin).href;
const image = new URL('/imgs/hero/1H-1440.webp', origin).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': `${origin}#person`, name: 'Leo Laguna', url: origin, jobTitle: 'Scientific Illustrator & 3D Developer' },
    { '@type': 'WebSite', '@id': `${origin}#website`, name: 'Leo Laguna', url, publisher: { '@id': `${url}#person` } },
  ],
};
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Leo Laguna" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content="Leo Laguna — scientific illustration and 3D visualization" />
<meta name="twitter:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{Astro.url.pathname === '/' && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>}
