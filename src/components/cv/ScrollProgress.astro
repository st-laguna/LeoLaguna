---
const { targetId } = Astro.props;
---

<div class="scroll-progress" data-target={targetId}>
  <div class="scroll-progress-bar"></div>
</div>

<style>
  .scroll-progress {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 3;
  }

  .scroll-progress-bar {
    width: 0%;
    height: 100%;
    background: var(--color-text);
    transition: width 0.1s linear;
  }
</style>

<script>
  document.querySelectorAll(".scroll-progress").forEach((barWrapper) => {
    const targetId = barWrapper.getAttribute("data-target");
    if (!targetId) return;

    const target = document.getElementById(targetId);
    const bar = barWrapper.querySelector(".scroll-progress-bar");
    if (!target || !bar) return;

    target.addEventListener("scroll", () => {
      const scrollable = target.scrollHeight - target.clientHeight;
      const progress = scrollable > 0 ? (target.scrollTop / scrollable) * 100 : 0;
      (bar as HTMLElement).style.width = `${progress}%`;
    });
  });
</script>