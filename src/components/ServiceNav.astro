---
// ServiceNav.astro
---
<div class="nav-wrapper">
    <nav id="service-nav" aria-label="Service navigation">
        <a href="/" id="nav-logo" class="nav-logo" aria-label="Home">
            <img src="/images/logo.svg" alt="Leo Laguna Studio" />
        </a>
        <div class="nav-links" id="nav-links">
            <a href="/"         class="nav-link" id="nav-home">HOME</a>
            <span class="nav-divider" aria-hidden="true"></span>
            <a href="/work"     class="nav-link">WORK</a>
            <span class="nav-divider" aria-hidden="true"></span>
            <a href="/services" class="nav-link">SERVICES</a>
            <span class="nav-divider" aria-hidden="true"></span>
            <button class="nav-link" id="nav-about">ABOUT</button>
        </div>
    </nav>
</div>

<style>
    .nav-wrapper {
        position: fixed;
        top: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
    }

    #service-nav {
        display: flex;
        align-items: center;
        background: #var(--color-bg);
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
        width: 44px;   /* empieza como círculo */
        opacity: 0;
        will-change: width, opacity;
    }

    .nav-logo {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 5px;
        transition: opacity 0.2s ease;
        overflow: hidden;
    }

    .nav-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: brightness(0) invert(1);
        opacity: 0;   /* el logo empieza invisible, GSAP lo revela */
    }

    .nav-logo:hover { opacity: 0.25; }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-right: 30px;
        padding-left: 120px;
        opacity: 0;
        white-space: nowrap;
    }

    .nav-link {
        background: none;
        border: none;
        cursor: pointer;
        font-family: 'Host Grotesk', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: rgba(189, 192, 191, 0.75);
        padding: 0.35rem 1rem;
        border-radius: 999px;
        white-space: nowrap;
        text-decoration: none;
        transition: color 0.2s ease, background 0.2s ease;
        line-height: 1;
    }

    .nav-link:hover {
        color: #var(--color-text);
        background: rgba(255, 255, 255, 0.05);
    }

    .nav-divider {
        display: block;
        width: 1px;
        height: 12px;
        background: rgba(255, 255, 255, 0.1);
        flex-shrink: 0;
    }
</style>

<script>
    import gsap from "gsap";

document.addEventListener("astro:page-load", () => {
    const nav     = document.getElementById("service-nav");
    const links   = document.getElementById("nav-links");
    const logoImg = document.querySelector("#nav-logo img") as HTMLElement;
    if (!nav || !links || !logoImg) return;

    const OPEN_WIDTH = 870;

    const tlOpen = gsap.timeline({ delay: 0.3 });

    tlOpen
        .to(nav,     { opacity: 1, duration: 0.55, ease: "power2.out" })
        .to(logoImg, { opacity: 1, duration: 0.5,  ease: "power2.out" })
        .to({},      { duration: 0.2 })
        .to(nav,     { width: OPEN_WIDTH, duration: 1.6, ease: "power4.out" })
        .to(links,   { opacity: 1, duration: 0.4,  ease: "power2.out" }, "-=0.25");


        // ── Animación de SALIDA (helper reutilizable) ────────────
        function animateOut(onComplete: () => void) {
            const tlClose = gsap.timeline({ onComplete });
            tlClose
                .to(links,   { opacity: 0, duration: 0.25, ease: "power2.in" })
                .to(nav,     { width: 44,  duration: 0.6,  ease: "expo.in" }, "-=0.1")
                .to(logoImg, { opacity: 0, duration: 0.2,  ease: "power2.in" }, "-=0.15")
                .to(nav,     { opacity: 0, duration: 0.2,  ease: "power2.in" });
        }


        // ── Home: salida + navegar ───────────────────────────────
        document.getElementById("nav-home")?.addEventListener("click", (e) => {
            e.preventDefault();
            animateOut(() => { window.location.href = "/"; });
        });


        // ── About: panel lateral ─────────────────────────────────
        document.getElementById("nav-about")?.addEventListener("click", () => {
            const panel   = document.getElementById("about-panel");
            const overlay = document.getElementById("panel-overlay");
            panel?.classList.remove("translate-x-full");
            overlay?.classList.remove("opacity-0", "pointer-events-none");
        });
    });
</script>