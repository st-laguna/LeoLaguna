---
import FooterGlass from './FooterGlass.astro';
import '../styles/footer.css';
---
<footer id="contact" class="footer" aria-label="Leo Laguna — Contact">
  <div class="footer__heading">
    <span class="footer__name" data-footer-enter="0">LEO LAGUNA<sup>©</sup></span>
    <a href="/" class="footer__mark" data-footer-enter="140" aria-label="Leo Laguna — Home"></a>
  </div>

      <a
        class="footer__marquee"
        data-footer-marquee
        data-footer-click-target
        data-footer-enter="80"
        href="mailto:hello@leolaguna.com"
        aria-label="Get in touch — hello@leolaguna.com"
      >
        <svg
          data-marquee-svg
          viewBox="0 -32 1400 200"
          preserveAspectRatio="xMinYMid meet"
          aria-hidden="true"
        >
          <g id="footer-marquee-track" data-marquee-track fill="currentColor"></g>
        </svg>

        <noscript>
          <span class="footer__fallback">GET IN TOUCH</span>
        </noscript>

        <span class="footer__mobile-message" aria-hidden="true">
          {['GET','IN','TOUCH'].map(word=><span class="footer__mobile-row"><span class="footer__mobile-track">{[0,1].map(()=> <span>{Array(4).fill(word+' · ').join('')}</span>)}</span></span>)}
        </span>

        <FooterGlass />
      </a>

      <div
        class="footer__click-cursor"
        data-footer-click-cursor
        aria-hidden="true"
      >
        <span>CLICK</span>
        <img src="/icons/arrow.svg" alt="" class="footer__click-arrow" />
      </div>

  <div class="footer__contact-info">
    <div><span>socials</span><a href="https://www.instagram.com/laguna.99/" target="_blank" rel="noopener noreferrer">Instagram</a><a href="https://www.linkedin.com/in/leolaguna/" target="_blank" rel="noopener noreferrer">LinkedIn</a></div>
    <div><span>contact</span><a href="mailto:hello@leolaguna.com">hello@leolaguna.com</a></div>
  </div>

  <div class="footer__bottom" data-footer-enter="0">
    <p class="footer__meta" data-footer-enter="140">LIMA, PERU © <span data-footer-year></span><br/><span data-footer-clock></span> (UTC−5)</p>
    <a class="footer__email" href="mailto:hello@leolaguna.com">hello@leolaguna.com</a>
    <div class="footer__social hover-group">
      <a class="hover-option" data-footer-enter="240" href="https://www.instagram.com/laguna.99/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a class="hover-option" data-footer-enter="340" href="https://www.linkedin.com/in/leolaguna/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</footer>
<style>
  @media (orientation:portrait) {
    :global(html) .footer[data-compact-portrait] {
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(0,var(--footer-logo-width,18vw)) minmax(0,var(--footer-contact-width,38vw)) minmax(0,1fr);
      grid-template-rows:minmax(0,1fr) auto;
      column-gap:4vw;
      row-gap:6svh;
      height:100svh;
      min-height:0;
      padding:12svh 0 6svh;
    }
    :global(html) .footer[data-compact-portrait] .footer__marquee {
      grid-column:1/-1;
      grid-row:1;
      position:relative;
      inset:auto;
      transform:none;
      height:100%;
      min-height:0;
      overflow:hidden;
      clip-path:none;
    }
    :global(html) .footer[data-compact-portrait] .footer__mobile-message {
      height:100%;
      justify-content:space-between;
      gap:0;
      font-size:var(--footer-portrait-type,clamp(128px,20vw,240px));
      line-height:1;
    }
    :global(html) .footer[data-compact-portrait] .footer__mobile-track {text-shadow:none;}
    :global(html) .footer[data-compact-portrait] .footer__heading {
      grid-column:2;
      grid-row:2;
      position:relative;
      inset:auto;
      align-self:center;
      height:auto;
      margin:0;
    }
    :global(html) .footer[data-compact-portrait] .footer__name {display:none;}
    :global(html) .footer[data-compact-portrait] .footer__mark {
      display:block;
      position:relative;
      inset:auto;
      transform:none;
      width:100%;
      height:auto;
      aspect-ratio:494.6 / 277.66;
    }
    :global(html) .footer[data-compact-portrait] .footer__contact-info {
      grid-column:3;
      grid-row:2;
      position:relative;
      inset:auto;
      align-self:center;
      min-width:0;
      margin:0;
      gap:clamp(14px,2svh,28px);
    }
    :global(html) .footer[data-compact-portrait] .footer__contact-info span {font-size:var(--footer-portrait-label,clamp(11px,1.3vw,17px));}
    :global(html) .footer[data-compact-portrait] .footer__contact-info a {font-size:var(--footer-portrait-contact,clamp(15px,2vw,26px));overflow-wrap:anywhere;}
  }
  :global(html) .footer[data-footer-refraction] .footer__marquee > :global(svg:not([data-marquee-svg])) {display:block!important;}
  :global(html) .footer[data-footer-refraction] .footer__marquee > :global([data-footer-glass]) {
    display:block!important;
    visibility:visible;
    z-index:1;
    overflow:hidden;
    background:transparent;
  }
  :global(html) .footer[data-footer-refraction="html"] :global([data-footer-glass]) {width:clamp(40px,7vw,100px);}
  @media (any-pointer:coarse), (max-width:1000px) and (max-height:500px) {
    :global(html) .footer[data-footer-refraction] :global([data-footer-glass]) {width:clamp(40px,7vw,100px);}
  }
  :global(html) .footer .footer__marquee:not([data-optics-visible]) > :global([data-footer-glass]) {visibility:hidden;}
  @media (max-width:700px) and (orientation:portrait) {
    .footer {
      --footer-logo-width:22vw;
      --footer-contact-width:56vw;
      --footer-portrait-type:clamp(78px,29vw,140px);
      --footer-portrait-label:clamp(10px,2.6vw,12px);
      --footer-portrait-contact:clamp(12px,3.2vw,18px);
    }
  }
</style>
<style>
  /* The phone's landscape closing row mirrors its portrait logo/contact content. */
  @media (max-width:1000px) and (max-height:500px) and (orientation:landscape) and (any-pointer:coarse) {
    :global(html:not([data-ipad])) .footer {
      display:grid;
      grid-template-columns:minmax(60px,14vw) minmax(0,1fr);
      column-gap:24px;
      row-gap:24px;
      padding-inline:24px;
    }
    :global(html:not([data-ipad])) .footer .footer__marquee {
      grid-column:1/-1;
      grid-row:1;
      width:calc(100% + 48px);
      margin-inline:-24px;
    }
    :global(html:not([data-ipad])) .footer .footer__heading {
      grid-column:1;
      grid-row:2;
      margin:0;
      align-self:center;
    }
    :global(html:not([data-ipad])) .footer .footer__name { display:none; }
    :global(html:not([data-ipad])) .footer .footer__mark {
      display:block;
      position:relative;
      inset:auto;
      transform:none;
      width:100%;
      height:auto;
      aspect-ratio:494.6 / 277.66;
    }
    :global(html:not([data-ipad])) .footer .footer__contact-info {
      grid-column:2;
      grid-row:2;
      display:flex;
      flex-wrap:wrap;
      align-items:start;
      align-self:center;
      gap:16px 28px;
      min-width:0;
      margin:0;
    }
    :global(html:not([data-ipad])) .footer .footer__contact-info a {
      font-size:clamp(14px,2.2vw,20px);
      overflow-wrap:anywhere;
    }
  }
</style>
<script>
  import { initFooter } from '../scripts/footer';
  let dispose: (()=>void)|undefined;
  function setup(){dispose?.();dispose=initFooter();}
  setup();
  document.addEventListener('astro:page-load',setup);
  function cleanup(){dispose?.();dispose=undefined;}
  document.addEventListener('astro:before-swap',cleanup);
  if(import.meta.hot)import.meta.hot.dispose(()=>{dispose?.();document.removeEventListener('astro:page-load',setup);document.removeEventListener('astro:before-swap',cleanup);});
</script>
