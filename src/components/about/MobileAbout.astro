---
import '../../styles/about-mobile.css';
import NavigationMenu from '../NavigationMenu.astro';
import { aboutInterests } from '../../scripts/about/mobileAboutContent';
const introLines = ['I CREATE SCIENTIFIC', 'ILLUSTRATIONS, TECHNICAL', 'VISUALS, 3D AND ANIMATION', 'FOR PROJECTS IN RESEARCH,', 'CONSERVATION, AQUACULTURE', 'AND ENGINEERING, TURNING', 'COMPLEX IDEAS INTO CLEAR,', 'ENGAGING VISUALS.'];
---
<div class="mobile-about" lang="en" data-mobile-about-ui data-state="closed" data-open="false" data-settled="true" data-orientation="portrait" aria-busy="false">
  <h1 class="mobile-about__sr" id="mobile-about-title">About me</h1>
  <div class="mobile-about__frame" data-mobile-frame>
    <button class="mobile-about__artwork" data-mobile-artwork type="button" aria-label="Explore About" aria-expanded="false" aria-controls="mobile-about-intro mobile-about-stickers">
      <svg class="mobile-about__head" data-mobile-head viewBox="0 0 1200 1330" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          {['top', 'bottom', 'left', 'right'].map(side => <clipPath id={`ma-split-${side}`} clipPathUnits="userSpaceOnUse"><polygon shape-rendering="crispEdges" /></clipPath>)}
          <linearGradient id="ma-contact-down" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
          <linearGradient id="ma-contact-up" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
          <linearGradient id="ma-contact-right" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
          <linearGradient id="ma-contact-left" x1="1" y1="0" x2="0" y2="0"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
          {[1, 2, 3].map(layer => <mask id={`ma-contact-alpha-${layer}`} maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="1330" style="mask-type: alpha"><image data-mobile-shadow-source={layer} width="1200" height="1330" preserveAspectRatio="none" /></mask>)}
        </defs>
        {/* Back to front: 4 → 1. The front layer remains the occluder. */}
        {[4, 3, 2, 1].map(layer => <g class="mobile-about__layer" data-mobile-layer={layer} style={`--layer-index:${layer - 1}`}>
          {['first', 'second'].map(side => <g class={`mobile-about__piece ${side}`}>
            <image width="1200" height="1330" preserveAspectRatio="none" />
            {layer < 4 && <g class="mobile-about__shadow" mask={`url(#ma-contact-alpha-${layer})`}><g class="mobile-about__shadow-portrait" /><g class="mobile-about__shadow-landscape" /></g>}
          </g>)}
        </g>)}
      </svg>
    </button>
    <section class="mobile-about__intro" id="mobile-about-intro" aria-label="A little about me" aria-hidden="true" inert>
      <div class="mobile-about__intro-copy">
        <p class="mobile-about__facts">OCEAN NERD<br />BASED IN LIMA, PERU<br />DRAWING ANIMALS<br />SINCE FOREVER<br />3D WHEN 2D ISN’T<br />ENOUGH<br />PROBABLY FIXING A<br />DETAIL NOBODY ELSE<br />NOTICED...</p>
        <span class="mobile-about__ampersand" aria-hidden="true">&amp;</span>
        <p class="mobile-about__description">{introLines.map(line => <span>{line}{' '}</span>)}</p>
      </div>
      <button data-mobile-next type="button" aria-label="Explore my interests">tap to explore <span class="mobile-about__tap-arrow" aria-hidden="true">↗</span></button>
    </section>
    <div class="mobile-about__stickers mobile-about__wheel" id="mobile-about-stickers" role="region" aria-roledescription="carousel" aria-label="Explore my interests" aria-hidden="true" inert>
      {aboutInterests.map((interest, index) => <div class="mobile-about__wheel-slot" data-wheel-slot style={`--sticker-index:${index}`}><div class="mobile-about__float"><button class="mobile-about__sticker" type="button" data-mobile-interest={interest.id} aria-label={`Explore ${interest.title.toLowerCase()}`} aria-haspopup="dialog" aria-controls="mobile-about-info" style={`--sticker-index:${index};--sticker-rotation:${interest.rotation}`}>
        <img data-sticker-asset={interest.asset} alt={interest.title} decoding="async" width="640" height="640" />
      </button></div></div>)}
    </div>
    <button class="mobile-about__hint" data-mobile-hint-action type="button" aria-label="Explore About"><span data-mobile-hint>tap to explore</span> <span class="mobile-about__tap-arrow" aria-hidden="true">↗</span></button>
    <p class="mobile-about__sr" data-mobile-status role="status" aria-live="polite"></p>
  </div>
  <NavigationMenu context="about" id="mobile-about-menu" formal links={[
    {label:'Home',href:'/'},{label:'Service',href:'/#work'},
    {label:'Work',href:'/#featured-works'},{label:'Contact',href:'/#contact'},
  ]} />
  <dialog class="mobile-about__info" id="mobile-about-info" aria-labelledby="mobile-about-info-title">
    <button class="mobile-about__info-close" data-mobile-info-close type="button" aria-label="Close interest card">×</button>
    <img data-mobile-info-image alt="" decoding="async" width="640" height="640" />
    <div><h2 id="mobile-about-info-title"></h2><p data-mobile-info-copy></p></div>
  </dialog>
</div>
