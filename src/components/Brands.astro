---
import { brands } from '../data/brands';
import en from '../i18n/en.json';
import '../styles/brands.css';
import '../styles/mobile-brands-reveal.css';
const t = en as Record<string,string>;
---
<section id="brands" class="brands" data-brands aria-labelledby="brands-statement">
  <div class="brands-layout">
    <div class="brands-info">
    <dl class="brands-stats">
      <div><dt data-i18n="brands.years">YEARS</dt><dd><span data-count-to="5">5</span></dd></div>
      <div><dt data-i18n="brands.count">BRANDS</dt><dd><span data-count-to="15">15</span>+</dd></div>
      <div><dt data-i18n="brands.projects">PROJECTS</dt><dd>+<span data-count-to="80">80</span></dd></div>
      <div><dt data-i18n="brands.countries">COUNTRIES</dt><dd>+<span data-count-to="20">20</span></dd></div>
    </dl>
    <h2 id="brands-statement" class="brands-statement" data-i18n="brands.statement">{t['brands.statement']}</h2>
    </div>

    <div class="brands-grid">
      {[0,1].map(column=><div class="brands-column" data-brand-column={column}>
      {brands.filter((_,index)=>index%2===column).map(brand=>(
        <button
          type="button"
          data-brand-preview={`/imgs/brands/previews/${brand.file}.webp`}
          aria-controls="brand-preview" aria-expanded="false"
          class="brands-cell"
          style={`--brand-span:${brand.span};--brand-order:${brands.indexOf(brand)};--brand-scale:${brand.scale ?? 1}`}
          data-brand-shape={['ISRA3','WEWHALE3','KA','WWF3','IMA3','EXO3','QW3','RH'].includes(brand.file) ? 'square' : 'wide'}
          data-brand-name={brand.name}
          aria-label={brand.name}
        >
          <span class="brand-turn"><span class="brand-front"><picture><source media="(max-width:1000px), (orientation:portrait), (pointer:coarse)" srcset={`/imgs/brands/previews/responsive/${brand.file}-640.webp 640w, /imgs/brands/previews/responsive/${brand.file}-960.webp 960w, /imgs/brands/previews/${brand.file}.webp 1300w`} sizes={`(max-width:700px) calc((100vw - 50px) * ${brand.file === 'HAVIDA3' ? 2 : 1} / 3), calc((min(100vw, 1500px) - 100px) * ${['HAVIDA3','GROA3','MV'].includes(brand.file) ? 2 : 1} / 4)`} /><img src={`/imgs/brands/previews/${brand.file}.webp`} alt="" loading="lazy" decoding="async" /></picture></span><span class="brand-logo"><img src={`/imgs/brands/${brand.file}.svg`} data-brand-original={`/imgs/brands/${brand.file}.svg`} data-brand-white={['WWF3','COA3','IMA3','SPERMWHALES3'].includes(brand.file)?`/imgs/brands/${brand.file}_W.svg`:undefined} alt="" loading="lazy" decoding="async" draggable="false" /></span></span>
        </button>
      ))}
      </div>)}
    </div>

  </div>

  <div id="brand-preview" class="brand-preview" hidden><figure><div class="brand-preview-image"></div><figcaption></figcaption></figure><button type="button" class="brand-preview-close" data-i18n="brands.close">{t['brands.close']}</button></div>
</section>
<style>
  @media (min-width:1001px) {
    :global(html:not([data-tablet-portrait])) .brands-layout {
      max-width:2000px;
      grid-template-columns:minmax(0,72fr) minmax(150px,28fr);
      gap:clamp(32px,5vw,88px);
    }
    :global(html:not([data-tablet-portrait])) .brands-grid {
      grid-template-rows:repeat(4,clamp(125px,14svh,190px));
    }
    :global(html:not([data-tablet-portrait])) .brands-cell img {
      transform:scale(var(--brand-scale,1));
      transform-origin:center;
    }
    :global(html:not([data-tablet-portrait])) .brands-cell[data-brand-shape="square"] img {
      max-width:clamp(80px,7.5vw,150px);
      max-height:clamp(80px,7.5vw,150px);
    }
    :global(html:not([data-tablet-portrait])) .brands-stats {
      justify-self:end;
      align-self:center;
      text-align:right;
    }
    :global(html:not([data-tablet-portrait])) .brands-stats dd {
      font-size:clamp(48px,4vw,76px);
    }
    :global(html:not([data-tablet-portrait])) .brands-stats dt {
      font-size:clamp(14px,1.1vw,20px);
    }
    :global(html:not([data-tablet-portrait])) .brands-statement {
      grid-column:3;
      justify-self:start;
      align-self:center;
      text-align:left;
    }
  }
  :global(html[data-tablet-portrait]) .brands-layout {
    grid-template-columns:minmax(0,1fr) minmax(0,2fr);
    gap:28px;
  }
  :global(html[data-tablet-portrait]) .brands-stats {
    justify-self:end;
    align-self:center;
    text-align:right;
  }
  :global(html[data-tablet-portrait]) .brands-stats dd {
    font-size:clamp(62px,8.5vw,120px);
  }
  :global(html[data-tablet-portrait]) .brands-stats dt {
    font-size:clamp(13px,1.7vw,17px);
  }
  :global(html[data-tablet-portrait]) .brands-statement {
    grid-column:3;
    justify-self:start;
    align-self:center;
    text-align:left;
    width:100%;
    max-width:100%;
    min-width:0;
  }
  :global(html[data-tablet-portrait]) .brands-cell img {
    transform:scale(var(--brand-scale,1));
    transform-origin:center;
  }
</style>
<script>
  import '../scripts/brands';
</script>

