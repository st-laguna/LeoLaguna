---
import type { Project } from '../data/projects';
const { project, desktop = false } = Astro.props as {project: Project; desktop?: boolean};
// Audio streams verified with ffprobe; presentation metadata leaves the dataset intact.
const videosWithAudio = new Set(['/videos/havida.webm', '/videos/3.webm', '/videos/9.webm']);
const icons = [{id:'sound-off',x:448,label:'Enable sound / Activar sonido',action:'sound'}, {id:'skip-back',x:0,label:'Previous video / Video anterior',action:'previous'}, {id:'play',x:192,label:'Play / Reproducir',action:'play'}, {id:'skip-forward',x:256,label:'Next video / Video siguiente',action:'next'}, {id:'fullscreen',x:512,label:'Fullscreen / Pantalla completa',action:'fullscreen'}];
---
<div class:list={['av-editor', {'av-desktop':desktop}]} data-av-editor={desktop ? undefined : ""} data-av-desktop={desktop ? "" : undefined} hidden>
  {desktop ? <div class="av-desktop-track" data-desktop-track data-lenis-prevent tabindex="0" aria-label="Video gallery / Galería de videos">
    {project.assets.map((asset,i)=><button type="button" class="av-desktop-item" data-desktop-item={i} aria-label={`Select video ${i+1}`}><div class="av-desktop-media"><img src={asset.poster || asset.src.replace('/videos/','/videos/mini/').replace('.webm','.webp')} alt="" loading="lazy" /></div></button>)}
  </div> : <div class="av-screen" data-av-screen></div>}
  <div class="av-controls" role="group" aria-label="Video controls / Controles de video">
    {icons.map(icon => <button type="button" data-av-action={icon.action} aria-label={icon.label}>
      <svg viewBox={`${icon.x} 0 64 64`} aria-hidden="true"><use href={`/icons/iconos_reproductor.svg#${icon.id}`} /></svg>
      {icon.action==='play' && <span class="av-pause" aria-hidden="true"><i></i><i></i></span>}
    </button>)}
  </div>
  <div class="av-timecode"><span data-av-current>00:00:00:00</span><span data-av-end>00:00:00:00</span></div>
  <div class="av-timeline">
    <div class="av-ruler" aria-hidden="true">{Array.from({length:61},(_,i)=><i class:list={{major:i%10===0,medium:i%5===0}} />)}</div>
    <div class="av-clips" data-av-clips role="group" aria-label="Video clips / Clips de video" data-lenis-prevent>
      {project.assets.map((asset,i)=><button type="button" data-av-clip={i} data-has-audio={videosWithAudio.has(asset.src)} data-src={asset.src} data-poster={asset.poster || asset.src.replace('/videos/','/videos/mini/').replace('.webm','.webp')} aria-label={`Video ${String(i+1).padStart(2,'0')}${asset.client ? ` — ${asset.client}` : ''}`} aria-pressed={i===0}>
        <img src={asset.poster || asset.src.replace('/videos/','/videos/mini/').replace('.webm','.webp')} alt="" loading="lazy" decoding="async" />
        <span>{String(i+1).padStart(2,'0')}</span>
      </button>)}
    </div>
    <div class="av-playhead" aria-hidden="true"></div>
  </div>
  <p class="av-status" data-av-status role="status"></p>
</div>
<script>
  import '../scripts/animation-video-player';
  import '../scripts/animation-video-desktop';
</script>
