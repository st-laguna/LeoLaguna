  <button
    class="glass-toggle"
    type="button"
    aria-label="Abrir / cerrar menú"
    aria-expanded="false"
    aria-controls="glass-project-menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
    <nav id="glass-project-menu" aria-label="Portfolio" inert>
      <a href="/" data-i18n="nav.home">HOME</a>
      <a href="#work" data-i18n="nav.work">WORK</a>
      <a href="/about/" data-i18n="nav.about">ABOUT</a>
      <a href="#contact" data-i18n="nav.contact">CONTACT</a>
    </nav>
  <aside class="projects-sidebar" data-glass-sidebar>

  </aside>

<style>

  /* El contenido utiliza todo el ancho. */
  :global(.projects[data-horizontal] .projects-stage) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Vidrio independiente del botón y del menú. */
  :global(.projects[data-horizontal]) .projects-sidebar {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--media-gap) + 110px);
    padding: 0;
    z-index: 10;
    display: block;
    background: transparent;
    overflow: visible;
    pointer-events: none;

    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .projects-sidebar::before {
    display: none;
  }

  /* A narrow native blur samples the real HTML; no RGB wash or SVG filter chain. */
  :global(.projects[data-horizontal]) .projects-sidebar::before {
    content: "";
    display: block;
    position: absolute;
    inset: 0 auto 0 0;
    width: min(100%, calc(var(--project-left) + clamp(24px, 2vw, 40px)));
    pointer-events: none;
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    -webkit-mask-image: linear-gradient(90deg, #000 65%, transparent);
    mask-image: linear-gradient(90deg, #000 65%, transparent);
  }

  /* Botón: área de clic amplia, rayitas pequeñas. */
  .glass-toggle {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 72px;
    height: 88px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    mix-blend-mode: difference;
    cursor: pointer;
    pointer-events: auto;
    touch-action: manipulation;
    z-index: 11;
  }

  :global(.projects[data-horizontal]) .glass-toggle {
    display: flex;
  }

  .glass-toggle:disabled {
    pointer-events: none;
  }

  .glass-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: transform 350ms ease;
  }

  .glass-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .glass-toggle[aria-expanded="true"] span:nth-child(2) {
    transform: scaleX(0);
  }

  .glass-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Menú independiente: abrirlo no modifica el vidrio. */
  #glass-project-menu {
    position: absolute;
    top: 50%;
    left: 72px;
    right: auto;
    transform: translateY(-50%);
    box-sizing: border-box;
    width: 230px;
    max-width: calc(100vw - 88px);
    margin: 0;
    padding: 30px 24px;
    display: grid;
    gap: 18px;
    border: 1px solid rgb(128 128 128 / 18%);
    border-radius:0;
    background: var(--background);
    color: var(--foreground);
    font-family: inherit;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    z-index: 12;
    isolation: isolate;

    filter: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    mix-blend-mode: normal;

    clip-path: inset(0 100% 0 0);
    visibility: hidden;
    pointer-events: none;

    transition:
      clip-path 450ms cubic-bezier(.22, 1, .36, 1),
      visibility 0s 450ms;
  }

  #glass-project-menu[data-open] {
    clip-path: inset(0);
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  #glass-project-menu a {
    position: relative;
    display: block;
    padding: 8px 0 8px 18px;
    color: inherit;
    text-decoration: none;
  }

  /* Punto naranja únicamente al pasar el cursor o enfocar. */
  #glass-project-menu a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius:0;
    background: #ff8a00;
    transform: translateY(-50%);
    visibility: hidden;
  }

  #glass-project-menu a:hover::before,
  #glass-project-menu a:focus-visible::before {
    visibility: visible;
  }

  .glass-toggle:focus-visible,
  #glass-project-menu a:focus-visible {
    outline: 2px solid var(--accent, #ff8a00);
    outline-offset: 4px;
  }

  :global(.projects:not([data-horizontal])) .projects-sidebar,
  :global(.projects:not([data-horizontal])) .glass-toggle,
  :global(.projects:not([data-horizontal])) #glass-project-menu {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-toggle span,
    #glass-project-menu {
      transition: none;
    }
  }
</style>

<script>
  let dispose: (() => void) | undefined;
  function setup() {
  dispose?.();
  const sidebar = document.querySelector<HTMLElement>(
    '[data-glass-sidebar]'
  );

  if (sidebar) {
        const toggle = sidebar.parentElement!.querySelector<HTMLButtonElement>(
      '.glass-toggle'
    )!;
    const menu = sidebar.parentElement!.querySelector<HTMLElement>(
  '#glass-project-menu'
)!;
    const events = new AbortController();

      function setOpen(open: boolean) {
        sidebar!.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        menu.inert = !open;
        menu.toggleAttribute('data-open', open);
      }

    toggle.addEventListener('click', () => {
      setOpen(!sidebar.hasAttribute('data-open'));
    }, { signal: events.signal });

    menu.addEventListener('click', event => {
      if ((event.target as Element).closest('a')) {
        setOpen(false);
      }
    }, { signal: events.signal });

    document.addEventListener('pointerdown', event => {
      if (
        !sidebar.contains(event.target as Node) &&
        !toggle.contains(event.target as Node) &&
        !menu.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    }, { signal: events.signal });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && sidebar.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus({ preventScroll: true });
      }
    }, { signal: events.signal });

    dispose = () => events.abort();
  }
  }
  setup();
  document.addEventListener('astro:page-load', setup);
  function cleanup() { dispose?.(); dispose=undefined; }
  document.addEventListener('astro:before-swap', cleanup);
  if (import.meta.hot) import.meta.hot.dispose(() => {
    dispose?.();
    document.removeEventListener('astro:page-load', setup);
    document.removeEventListener('astro:before-swap', cleanup);
  });
</script>
