---
import SiteControls from './SiteControls.astro';
const { home = false, project = true } = Astro.props;
---
<div class="page-controls">
  {home && <a class="home-link" href="/" data-roll-link><span data-roll-label data-roll-preserve data-i18n="nav.home">HOME</span></a>}
  <SiteControls project={project} />
</div>
<style>
  .page-controls { display:flex; align-items:center; flex-wrap:wrap; gap:6px; color:var(--color-text, #171717); }
  .home-link { display:grid; place-items:center; min-height:36px; padding:0 8px; border:1px solid currentColor; border-radius:0; color:inherit; text-decoration:none; font:500 11px 'Host Grotesk',sans-serif; }
  .page-controls :global(.site-controls) { position:static; gap:6px; }
  .page-controls :global(.theme) { width:56px; }
  .page-controls :global(.language button) { width:25px; }
  .home-link:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  :global(html[data-theme='dark']) .page-controls { color:#f7f7f7; }
  /* Shared tablet targets also apply on CV, which does not load global.css. */
  :global(html:is([data-ipad],[data-tablet-layout])) .page-controls {gap:16px;}
  :global(html:is([data-ipad],[data-tablet-layout])) .page-controls :global(.site-controls) {gap:12px;}
  :global(html:is([data-ipad],[data-tablet-layout])) .page-controls :global(.theme) {width:92px;}
  :global(html:is([data-ipad],[data-tablet-layout])) .page-controls :global(.language button) {min-width:44px;}
  :global(html:is([data-ipad],[data-tablet-layout])) .home-link {min-width:44px;padding-inline:12px;}
</style>
