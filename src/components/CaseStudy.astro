---
import {responsiveWorkImage} from '../data/responsive-work-image';
import CaseEdgeGlass from './CaseEdgeGlass.astro';
import {resolve} from 'node:path';
import type {CaseStudy} from '../data/case-studies';
import {caseStudies} from '../data/case-studies';
import {categoryKeys} from '../data/work-categories';
import en from '../i18n/en.json';
import '../styles/case-study.css';
interface Props {project:CaseStudy}
const {project}=Astro.props;
// PROTOTYPE: set false to remove Work edge glass without changing the layout.
const edgeGlassPrototype=true;
const next=caseStudies.find(item=>item.slug===project.nextProject)!;
const others=caseStudies.filter(item=>item.slug!==project.slug && item.slug!==next.slug);
const labels=en as Record<string,string>;
const sequence=project.media || project.images.map(src=>src?{kind:'image' as const,src}:null);
const images=await Promise.all(sequence.map(async item=>!item?null:item.kind==='image'?{...item,...await responsiveWorkImage(item.src)}:{...item,width:item.width,height:item.height}));
const imageColumns=project.imageColumns || images.map((_,index)=>[index]);
const preview=project.nextPreview||next.cover;
const previewSize=await responsiveWorkImage(preview);
---
<main class="case-study" data-horizontal data-case-study data-page-content aria-labelledby="case-title">
  <div class="case-study__stage">
    <div class="case-study__rail" data-case-rail>
      <section class="case-study__intro">
        <div class="case-study__intro-title"><a class="case-study__back case-study__circle" href="/#featured-works" aria-label="Back to Featured Works / Volver a trabajos destacados"><span class="action-arrow" data-direction="diagonal-left" aria-hidden="true"><span data-arrow="↖">↖</span></span></a><h1 id="case-title" data-i18n={"case."+project.slug+".title"}>{labels["case."+project.slug+".title"]||project.title}</h1><button class="case-study__intro-direction case-study__circle" data-case-intro-next type="button" aria-label="Continue to project / Continuar al proyecto">→</button></div>
        <dl class="case-study__metadata">
          <div><dt data-i18n="case.client">Client</dt><dd>{project.client}</dd></div>
          <div><dt data-i18n="case.service">Service</dt><dd data-i18n={categoryKeys[project.categoryId]}>{labels[categoryKeys[project.categoryId]]}</dd></div>
          <div><dt data-i18n="case.location">Location</dt><dd data-i18n={'case.'+project.slug+'.location'}>{labels['case.'+project.slug+'.location']||project.location||'—'}</dd></div>
          <div><dt data-i18n="case.date">Date</dt><dd>{project.year}</dd></div>
        </dl>
      </section>
      {project.model && <section class="case-study__model" data-case-model data-model={project.model} aria-label="Interactive 3D model">
        <button class="case-study__retreat case-study__circle" data-case-retreat type="button" aria-label="Back to project introduction / Volver a la introducción">←</button>
        <button class="case-study__advance case-study__circle" data-case-advance type="button" aria-label="Continue to project images / Continuar a las imágenes">→</button>
        <span data-model-status role="status" data-i18n="model.loading">Loading 3D model…</span>
        <button class="case-study__model-explore" data-model-explore disabled type="button" data-i18n="model.explore">Explore 3D model</button>
        <div class="case-study__model-controls">
          <span class="case-study__model-hint" data-i18n="model.drag">Drag to rotate</span>
          <div class="case-study__zoom" role="group" aria-label="Model zoom" data-i18n-aria-label="model.zoom">
            <button data-zoom-step="-1" disabled type="button" aria-label="Decrease zoom" data-i18n-aria-label="model.zoomOut">−</button>
            <input data-model-zoom disabled type="range" min="0" max="100" step="1" value="0" aria-label="Model zoom" data-i18n-aria-label="model.zoom" aria-orientation="horizontal" />
            <button data-zoom-step="1" disabled type="button" aria-label="Increase zoom" data-i18n-aria-label="model.zoomIn">+</button>
          </div>
          <div class="case-study__model-actions">
          <button class="case-study__model-reset" data-model-reset disabled type="button" aria-label="Reset view" data-i18n-aria-label="model.reset"><span aria-hidden="true"></span></button>
          <button class="case-study__explode" data-explode disabled type="button" aria-label="Explode model" data-i18n-aria-label="model.explode" aria-pressed="false"><span aria-hidden="true"></span></button>
          </div>
        </div>
      </section>}
      <div class="case-study__images">
        {imageColumns.map(column=>(
          <div class:list={['case-study__image-column',{'case-study__image-stack':column.length>1}]} style={column.length>1?'--stack-ratio:'+Math.max(...column.map(index=>images[index]!.width/images[index]!.height)):undefined}>
          {column.map(index=>{const image=images[index];return (
          <figure class="case-study__image" data-image-slot={index+1} hidden={!image} style={image ? '--image-ratio:'+image.width/image.height+(image.kind==='video' && images[0] ? ';--video-reference-ratio:'+images[0].width/images[0].height : '') : undefined}>
            {image?.kind==='image' && <img src={index===0?image.src:undefined} data-case-src={index===0?undefined:image.src} srcset={index===0?image.srcset:undefined} data-srcset={index===0?undefined:image.srcset} sizes={`(max-width:1400px) calc((100dvh - 16px) * ${image.width/image.height}), calc((100svh - 180px) * ${image.width/image.height})`} width={image.width} height={image.height} style={'--image-ratio:'+image.width/image.height} alt={project.client+' — '+String(index+1).padStart(2,'0')} loading="eager" fetchpriority={index===0?'high':'auto'} decoding="async" />}
            {image?.kind==='video' && <video data-case-video data-case-poster={image.src.replace('/videos/','/videos/mini/').replace(/\.webm$/i,'.webp')} src={image.src} width={image.width} height={image.height} style={'--image-ratio:'+image.width/image.height} muted loop playsinline preload="none" aria-label={project.client+' — animation'} />}
          </figure>
          );})}
          </div>
        ))}
      </div>
      <section class="case-study__end" aria-label="More case studies">
        <nav class="case-study__others" aria-label="Other Cases"><span data-i18n="case.other">Other Cases</span>{others.map(item=><a href={'/work/'+item.slug+'/'}><span><span data-i18n={'case.'+item.slug+'.title'}>{labels['case.'+item.slug+'.title']||item.title}</span> — {item.client}</span><span class="case-study__other-arrow" aria-hidden="true"><span class="action-arrow" data-direction="diagonal"><span data-arrow="↗">↗</span></span></span></a>)}</nav>
      <a class="case-study__next" data-roll-link href={'/work/'+next.slug+'/'} aria-label={'Next Case Study: '+next.title} data-i18n-aria-label={'case.'+next.slug+'.title'}>
        <span class="case-study__next-label"><span data-roll-label data-roll-preserve data-i18n="case.next">Next Case Study</span> <span aria-hidden="true">↗</span></span>
        <div class="case-study__next-heading"><h2 data-i18n={'case.'+next.slug+'.title'}>{labels['case.'+next.slug+'.title']||next.title}</h2><span>{next.client}</span></div>
        <div class="case-study__preview">
          <img data-case-src={preview} data-srcset={previewSize.srcset} sizes="(max-width:1400px) 100vw, 50vw" width={previewSize.width} height={previewSize.height} alt={next.client} loading="eager" fetchpriority="auto" decoding="async" />
          <div class="case-study__next-meta"><span data-i18n={categoryKeys[next.categoryId]}>{labels[categoryKeys[next.categoryId]]}</span><span>{next.year}</span></div>
        </div>
      </a>
      </section>
    </div>
    {edgeGlassPrototype && <CaseEdgeGlass />}
  </div>
</main>
<script>import '../scripts/case-study';</script>
