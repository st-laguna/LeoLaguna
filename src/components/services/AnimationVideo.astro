<Layout>
    <div class="columns-3 gap-0">
        {
            items.map((item, index) => (
                <figure transition:name={item.name} class="flex flex-col gap-1 break-inside-avoid border border-gray-600 p-3 rounded-lg">
                    <div class="text-xs">{index+1}</div>
                    <img
                            src={item.image}
                            alt=""
                            class="w-full overflow-hidden rounded-md"
                    />
                    <h3>{item.title}</h3>
                </figure>
            ))
        }
    </div>
</Layout>
