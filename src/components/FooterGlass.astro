{['left','right'].map(side => (
  <span class={`footer-glass footer-glass--${side}`} data-footer-glass={side} aria-hidden="true" />
))}
<canvas data-footer-refraction-canvas aria-hidden="true" />
<style>
.footer-glass {position:absolute;top:0%;bottom:0%;width:clamp(40px,10vw,220px);pointer-events:none;visibility:hidden;}
.footer-glass::before {content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgb(110 215 235 / .18),rgb(235 140 175 / .09) 35%,transparent);}
.footer-glass--left {left:0;}
.footer-glass--right {right:0;}
.footer-glass--right::before {transform:scaleX(-1);}
[data-footer-refraction-canvas] {position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;visibility:hidden;}
:global([data-optics-visible][data-glass-gpu]) > [data-footer-refraction-canvas] {visibility:visible;}
:global([data-glass-gpu]) > .footer-glass::before {display:none;}
</style>
