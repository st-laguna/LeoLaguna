---
import en from '../i18n/en.json';
import '../styles/gallery-footer.css';
const t=en as Record<string,string>;
---
<footer class="gallery-footer gallery-footer--compact" aria-label="Leo Laguna">
  <button class="gallery-footer-logo" type="button" data-gallery-top aria-label="Leo Laguna — Back to gallery top"></button>
  <div class="gallery-contact">
    <span class="gallery-footer-label" data-i18n="footer.contact">{t['footer.contact']}</span>
    <a data-roll-link href="mailto:hello@leolaguna.com"><span data-roll-label data-roll-preserve>hello@leolaguna.com</span></a>
    <div class="gallery-contact-networks">
      <a data-roll-link href="https://www.instagram.com/laguna.99/" target="_blank" rel="noopener noreferrer"><span data-roll-label>Instagram</span> ↗</a>
      <a data-roll-link href="https://www.linkedin.com/in/leolaguna/" target="_blank" rel="noopener noreferrer"><span data-roll-label>LinkedIn</span> ↗</a>
    </div>
  </div>
  <span class="gallery-return-slot" data-gallery-return-slot></span>
</footer>
