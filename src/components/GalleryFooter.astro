---
import en from '../i18n/en.json';
const t=en as Record<string,string>;
---
<footer class="gallery-footer" aria-label="Leo Laguna">
  <div class="gallery-footer-meta"><p>Lima, Perú <span data-gallery-clock></span><br/><span data-gallery-date></span> (UTC−5)</p><p>©<span data-gallery-year></span> Leo Laguna</p></div>
  <div class="gallery-footer-center"><button class="gallery-footer-logo" type="button" data-gallery-top aria-label="Leo Laguna — Back to gallery top"></button><div><span class="gallery-footer-label" data-i18n="footer.contact">{t['footer.contact']}</span><a data-roll-link href="mailto:hello@leolaguna.com"><span data-roll-label data-roll-preserve>hello@leolaguna.com</span></a><p><span data-i18n="footer.based">{t['footer.based']}</span><br/><span data-i18n="footer.worldwide">{t['footer.worldwide']}</span></p></div></div>
  <div class="gallery-footer-social hover-group"><span class="gallery-footer-label" data-i18n="footer.connect">{t['footer.connect']}</span><a class="hover-option" data-roll-link href="https://www.instagram.com/laguna.99/" target="_blank" rel="noopener noreferrer"><span data-roll-label>Instagram</span> ↗</a><a class="hover-option" data-roll-link href="https://www.linkedin.com/in/leolaguna/" target="_blank" rel="noopener noreferrer"><span data-roll-label>LinkedIn</span> ↗</a><span class="gallery-return-slot" data-gallery-return-slot aria-hidden="true"></span></div>
</footer>
