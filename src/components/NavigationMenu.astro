---
import SiteControls from './SiteControls.astro';
import '../styles/navigation-menu.css';
interface Link { label: string; href: string; i18n?: string; }
interface Props {
  context: 'site' | 'about';
  id: string;
  links: Link[];
  preferences?: boolean;
  formal?: boolean;
}
const { context, id, links, preferences = false, formal = false } = Astro.props;
---
<button class="mobile-menu-toggle" data-shared-menu-toggle data-menu-context={context} data-mobile-menu-toggle={context === 'about' ? '' : undefined} disabled={context === 'about'} type="button" aria-expanded="false" aria-controls={id} aria-label={context === 'about' ? 'Open menu' : 'Open menu / Abrir menú'}>
  <span></span><span></span><span></span>
</button>
<div class="mobile-menu-panel" id={id} data-shared-menu-panel data-menu-context={context} data-menu-compact={context === 'about' ? '' : undefined} data-mobile-menu={context === 'site' ? '' : undefined} inert>
  <nav class="site-nav" aria-label={context === 'site' ? 'Navegación principal' : 'Main navigation'}>
    <div class="site-nav__items hover-group" data-shared-menu-links>
      {links.map(link => <a class="hover-option" href={link.href} data-shared-nav-link>
        <span class="nav-state" aria-hidden="true"><span data-nav-entry-bracket="left">[</span><span class="nav-plus">+</span><span data-nav-entry-bracket="right">]</span></span><span data-nav-entry-label data-i18n={link.i18n}>{link.label}</span>
      </a>)}
    </div>
    <slot name="submenu" />
  </nav>
  <div class="shared-menu-footer">
    <SiteControls preferences={preferences} projectHref={formal ? '/cv/' : undefined} projectLabel={formal ? 'THE FORMAL STUFF' : undefined} projectI18n={!formal} />
  </div>
</div>
<script>
  import '../scripts/navigation-menu';
</script>
