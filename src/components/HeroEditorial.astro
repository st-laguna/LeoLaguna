---
import en from '../i18n/en.json';
const labels=en as Record<string,string>;
const stories=[0,1,2].map(i=>[labels[`hero.story.${i}.title`],labels[`hero.story.${i}.copy`]]);
const services=[0,1,2,3].map(i=>labels[`hero.service.${i}`]);
---
<div class="hero-editorial" data-hero-editorial>
 <nav class="hero-services" aria-label="Services" data-i18n-aria-label="hero.editorial.services">
  {services.map((name,i)=><a href="#work" data-project-jump={i} data-hero-service={i} data-active={i===0?'':undefined}><span class="service-marker" aria-hidden="true"><span class="marker-bracket">[</span><span class="marker-plus">+</span><span class="marker-bracket">]</span></span><span data-i18n={`hero.service.${i}`}>{name}</span></a>)}
 </nav>
 <section class="hero-stories" aria-label="Background, experience and approach" data-i18n-aria-label="hero.editorial.stories" aria-roledescription="carousel">
  <div class="hero-story-panels">
   {stories.map(([title,copy],i)=><article data-hero-story={i} data-active={i===0?'':undefined} aria-hidden={i!==0} inert={i!==0}><h2 data-i18n={`hero.story.${i}.title`}>{title}</h2><p data-i18n={`hero.story.${i}.copy`}>{copy}</p></article>)}
  </div>
  <div class="hero-story-controls"><span data-story-count>01 / 03</span></div>
  <div class="hero-story-dots">{stories.map(([title],i)=><button type="button" data-story-select={i} aria-label={title} data-i18n-aria-label={`hero.story.${i}.title`} aria-pressed={i===0?'true':'false'}><span><i></i></span></button>)}</div>
 </section>
</div>
<script>import '../scripts/hero-editorial';</script>
<style>
.hero-editorial{display:none;}
@media(min-width:1001px) and (orientation:landscape){
 :global(html:not([data-ipad])) .hero-editorial{display:block;position:absolute;inset:0;pointer-events:none;color:#fff;--editorial-gap:var(--header-bot1-x,var(--page-gap));font-family:'Host Grotesk',sans-serif;}
 :global(html:not([data-ipad]) .hero__info){display:none;}
 .hero-services{position:absolute;right:calc(var(--editorial-gap) - var(--hero-service-shift,28px));bottom:calc(50% + 3.78vw + var(--editorial-gap));width:clamp(225px,17vw,360px);pointer-events:auto;}
 .hero-services a{display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:center;padding:6px 0;color:inherit;text-decoration:none;font-size:calc(clamp(10px,.75vw,14px) + 1px);line-height:1.35;}
 .hero-services a>span:last-child{opacity:.48;transform-origin:left center;transition:opacity .35s,transform .35s;}
 .hero-services,.hero-story-panels,.hero-story-controls{mix-blend-mode:difference;z-index:2;}
 .hero-story-panels,.hero-story-controls{position:relative;}
 .hero-services a>span:first-child{display:flex;align-items:center;justify-content:center;opacity:0;transform:translateY(4px);transition:opacity .35s,transform .35s;}
 .marker-plus{display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1);}
 .marker-bracket{opacity:0;transition:opacity .3s,transform .4s;}
 .marker-bracket:first-child{transform:translateX(4px);}
 .marker-bracket:last-child{transform:translateX(-4px);}
 .hero-services a:hover .marker-plus,.hero-services a:focus-visible .marker-plus{transform:rotate(45deg);}
 .hero-services a:hover .marker-bracket,.hero-services a:focus-visible .marker-bracket{opacity:1;transform:translateX(0);}
 .hero-services a:hover>span:first-child,.hero-services a:focus-visible>span:first-child{opacity:1;transform:translateY(0);}
 .hero-services a[data-active]>span:last-child,.hero-services a:hover>span:last-child,.hero-services a:focus-visible>span:last-child{opacity:1;transform:scale(1.04);}
 .hero-services a[data-active]>span:first-child{opacity:1;transform:translateY(0);}
 .hero-stories{position:absolute;left:var(--editorial-gap);top:calc(50% + 3.83vw + var(--editorial-gap) * 1.5);width:clamp(180px,13vw,300px);pointer-events:auto;}
 .hero-story-panels{display:grid;}
 .hero-story-panels article{grid-area:1/1;opacity:1;transform:translateY(0);transition:opacity .4s ease,transform .5s cubic-bezier(.22,1,.36,1),visibility 0s;}
 .hero-story-panels article:not([data-active]){display:block;visibility:hidden;opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .3s,transform .4s,visibility 0s .4s;}
 h2{font-size:calc(var(--ui-nav-size,clamp(11px,.95vw,15px)) - 1px);opacity:.5;font-weight:400;margin:0 0 16px;line-height:1.4;}
 p{font-size:var(--ui-nav-size,clamp(11px,.95vw,15px));line-height:1.3;margin:0;text-wrap:pretty;}
 .hero-story-controls{display:flex;align-items:center;gap:20px;margin-top:22px;font-size:11px;letter-spacing:.18em;font-variant-numeric:tabular-nums;}
 button{color:inherit;background:none;border:0;padding:6px;cursor:pointer;}
 .hero-story-dots{width:calc(100% - 40px);position:relative;z-index:2;display:flex;gap:10px;margin-top:6px;color:var(--foreground);}

 .hero-story-dots button{flex:1;min-width:0;height:24px;padding:8px 0;}
 .hero-story-dots span{display:block;position:relative;overflow:hidden;height:3px;background:color-mix(in srgb,currentColor 25%,transparent);}
 .hero-story-dots i{display:block;width:100%;height:100%;background:#EF6C65;transform:translateX(-100%);}
 .hero-story-dots button[aria-pressed="true"] i{transform:translateX(0);}

}
@media(prefers-reduced-motion:reduce){.hero-services a>span,.marker-plus,.marker-bracket,.hero-story-panels article,.hero-story-panels article:not([data-active]),.hero-story-dots::after{transition:none;}}
</style>
