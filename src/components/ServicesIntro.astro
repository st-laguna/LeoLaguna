<section class="services-intro" aria-label="Nexo" data-services-intro>
  <div class="nexo__motion">
    <div class="nexo__parallax">
      <p><span class="nexo__prefix">Every idea</span> <span class="nexo__needs">needs</span>
        <span class="nexo__second">its own visual.</span></p>
    </div>
  </div>
</section>
<style>
  :global(.services-transition) {position:relative;display:flow-root;background:var(--background);}
  :global(html body .services-transition > .projects[data-projects]) {z-index:2;margin-top:0!important;}
  .services-intro {position:sticky;top:16.5svh;z-index:1;clip-path:inset(0);height:67svh;display:grid;place-items:center;box-sizing:border-box;padding:20px var(--page-gap);background:var(--background);color:var(--foreground);}
  .nexo__motion {position:fixed;top:50svh;left:50%;transform:translate(-50%,-50%);opacity:1;}
  p {display:grid;grid-template-columns:max-content max-content;column-gap:.25em;margin:0;width:max-content;text-align:left;font-family:'Host Grotesk',sans-serif;font-size:clamp(18px,3vw,52px);font-weight:400;line-height:1.15;}
  p > span {white-space:nowrap;}
  .nexo__prefix {grid-column:1;grid-row:1;}
  .nexo__needs {grid-column:2;grid-row:1;}
  .nexo__second {grid-column:2;grid-row:2;}
</style>
<script>
  import gsap from 'gsap';
  import {ScrollTrigger} from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const intro=document.querySelector<HTMLElement>('[data-services-intro]');
  if(intro){
    const media=gsap.matchMedia();
    media.add('(prefers-reduced-motion:no-preference)',()=>{
      const host=intro.parentElement!;
      const services=host.querySelector<HTMLElement>('[data-projects]')!;
      const words=intro.querySelectorAll('p > span');
      let phase=0,exitAt=0,motion:gsap.core.Tween|undefined;
      gsap.set(words,{y:18});
      const servicesTop=()=>services.getBoundingClientRect().top+scrollY;
      function update(self:ScrollTrigger){
        const next=self.progress<=0?0:scrollY>=exitAt?2:1;
        if(next===phase)return;
        phase=next;motion?.kill();
        motion=gsap.to(words,{y:next===0?18:next===1?0:-18,duration:.8,stagger:.07,ease:'power3.inOut'});
      }
      ScrollTrigger.create({id:'nexo-entrance',trigger:host,start:'top 55%',end:()=>servicesTop()-innerHeight*.35,onUpdate:update,onRefresh:self=>{exitAt=servicesTop()-innerHeight*.6;update(self);}});
      return()=>motion?.kill();
    });
    if(import.meta.hot)import.meta.hot.dispose(()=>media.revert());
  }
</script>
