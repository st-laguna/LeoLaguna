---
import ContactCard from '../components/ContactCard.astro';
import '../styles/global.css';
import '../styles/tablet-portrait.css';
import '../styles/ipad-portrait.css';
import '../styles/header-persistent.css';
import '../styles/home-microinteractions.css';
import PageNavigation from '../components/PageNavigation.astro';
import SiteControls from '../components/SiteControls.astro';
import {readFileSync} from 'node:fs';
import {resolve} from 'node:path';
const headerSource=readFileSync(resolve('public/icons/logo_horizontal.svg'),'utf8');
const [,,blueprintWidth,blueprintHeight]=headerSource.match(/viewBox="([^"]+)"/)![1].split(/\s+/).map(Number);
const headerAnchors=Object.fromEntries(['services','about','works','contact','bot1','bo2','bo3','logo'].map(id=>{
  const rect=headerSource.match(new RegExp('<rect[^>]*id="'+id+'"[^>]*>'))![0];
  const values=Object.fromEntries(Array.from(rect.matchAll(/(x|y|width|height)="([^"]+)"/g),m=>[m[1],Number(m[2])]));
  return [id,values];
}));
const headerBlueprint=Object.entries(headerAnchors).flatMap(([id,a])=>[
  '--header-'+id+'-x:'+a.x/blueprintWidth*100+'vw',
  '--header-'+id+'-y:'+a.y/blueprintHeight*100+'svh',
  '--header-'+id+'-w:'+a.width/blueprintWidth*100+'vw',
]).concat([
  '--header-control-gap-1:'+(headerAnchors.bo2.x-headerAnchors.bot1.x-headerAnchors.bot1.width)/blueprintWidth*100+'vw',
  '--header-control-gap-2:'+(headerAnchors.bo3.x-headerAnchors.bo2.x-headerAnchors.bo2.width)/blueprintWidth*100+'vw',
]).join(';');
interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  page?: 'case-study';
}

const {
  title = 'Leo Laguna',
  description = 'Ilustración científica y comunicación visual.',
  lang = 'es',
  page,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href="/fonts/HostGrotesk.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <PageNavigation />
    <script is:inline>
      (() => {
        if (!['/', '/index.html'].includes(location.pathname)) return;
        // PageNavigation has already restored the theme. Match Hero's picture
        // selection so its later request reuses this one, without warming both themes.
        const portrait = matchMedia('(orientation:portrait), (max-width:1000px)').matches;
        const dark = document.documentElement.dataset.theme === 'dark';
        const preload = document.createElement('link');
        preload.rel = 'preload';
        preload.as = 'image';
        preload.fetchPriority = 'high';
        const phone = matchMedia('(max-width:700px), (max-width:1000px) and (max-height:500px)').matches;
        if (phone) {
          const name = dark ? '4H' : '3H';
          preload.imageSrcset = [480, 720, 960].map(width => `/imgs/hero/${name}-${width}.webp ${width}w`).join(', ');
          preload.imageSizes = '100vw';
          preload.href = `/imgs/hero/${name}-960.webp`;
        } else {
          if (portrait) {
            preload.href = `/imgs/hero/${dark ? '4H' : '3H'}.webp`;
          } else {
            const name = dark ? '2H' : '1H';
            preload.imageSrcset = [960, 1440, 1920].map(width => `/imgs/hero/${name}-${width}.webp ${width}w`).join(', ');
            preload.imageSizes = '100vw';
            preload.href = `/imgs/hero/${name}-1920.webp`;
          }
        }
        document.head.append(preload);
      })();
    </script>

<script is:inline>
  (() => {
    const home = ['/', '/index.html'].includes(location.pathname);
    const homeHash = ['', '#home', '#hero', '#hero-top'].includes(location.hash);
    const restored = performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!home || !homeHash || reduced || restored || document.documentElement.hasAttribute('data-cross-page')) return;

    history.replaceState(null, '', location.pathname + location.search);

    document.documentElement.setAttribute('data-hero-intro', '');
    document.documentElement.setAttribute('data-home-entry', '');

    // Evita restaurar una posición anterior al recargar el inicio.
    history.scrollRestoration = 'manual';

    // Release the initial flag if the inline Hero presentation cannot start.
    setTimeout(() => {
      document.documentElement.removeAttribute('data-hero-intro');
      document.documentElement.removeAttribute('data-home-entry');
      history.scrollRestoration = 'auto';
    }, 3500);
  })();
</script>



  </head>
  <body>
    <div class="theme-wipe" data-theme-wipe popover="manual" hidden aria-hidden="true"></div>
    <div data-home-curtain aria-hidden="true"></div>
    <header class="site-header" data-site-header style={headerBlueprint}>
      <a class="site-header__footer-logo" href={page ? "/#home" : "#home"} aria-label="Leo Laguna — Home"></a>
  <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open menu / Abrir menú">
    <span></span><span></span><span></span>
  </button>
  <div class="mobile-menu-panel" id="mobile-navigation" data-mobile-menu inert>
  <nav class="site-nav" aria-label="Navegación principal">
    <div class="site-nav__items hover-group">
      <a class="hover-option" href={page ? "/#work" : "#work"}><span class="nav-state" aria-hidden="true">[<span class="nav-plus">+</span>]</span><span data-i18n="nav.services">Service</span></a>
      <a class="hover-option" href="/about/"><span class="nav-state" aria-hidden="true">[<span class="nav-plus">+</span>]</span><span data-i18n="nav.about">About</span></a>
      <a class="hover-option" href={Astro.url.pathname === '/' ? '#featured-works' : '/#featured-works'}><span class="nav-state" aria-hidden="true">[<span class="nav-plus">+</span>]</span><span data-i18n="nav.works">Works</span></a>
      <a class="hover-option" href={page ? "/#contact" : "#contact"}><span class="nav-state" aria-hidden="true">[<span class="nav-plus">+</span>]</span><span data-i18n="nav.contact">Contact</span></a>
    </div>
    <div class="site-nav__submenu hover-group" id="site-work-options" hidden>
      <a class="hover-option" href="#work" data-project-jump="0" >01 Technical Visuals</a>
      <a class="hover-option" href="#work" data-project-jump="1" >02 Scientific Illustration</a>
      <a class="hover-option" href="#work" data-project-jump="2" >03 Educational Visuals</a>
      <a class="hover-option" href="#work" data-project-jump="3" >04 Animation and Video</a>
    </div>
  </nav>

  <SiteControls />
  </div>
</header>
    <slot />

    <script>
      import '../scripts/main';
      import '../scripts/action-buttons';
      import { isTabletPortrait } from '../scripts/responsive-layout';

      document.addEventListener('contextmenu', e => {
        if ((e.target as Element)?.closest('img, video')) e.preventDefault();
      });

      document.addEventListener('dragstart', e => {
        if ((e.target as Element)?.closest('img, video')) e.preventDefault();
      });

      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const menuButton = header?.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
      const menuPanel = header?.querySelector<HTMLElement>('[data-mobile-menu]');
      const menuMedia = matchMedia('(max-width:700px), (max-width:1000px) and (max-height:500px), (min-width:701px) and (max-width:1100px) and (orientation:portrait)');
      const tabletMedia = matchMedia('(min-width:701px) and (max-width:1100px) and (orientation:portrait)');
      const controls = header?.querySelector<HTMLElement>('.site-controls');
      function placeControls() {
        if (controls && header && menuPanel) menuPanel.append(controls);
      }
      tabletMedia.addEventListener('change', placeControls);
      placeControls();
      window.addEventListener('leo:orientation-ready', () => { placeControls(); setMobileMenu(false); });

      function setMobileMenu(open: boolean) {
        if (!header || !menuButton || !menuPanel) return;
        const phoneMenu = menuMedia.matches || isTabletPortrait();
        const active = open && phoneMenu;
        header.toggleAttribute('data-menu-open', active);
        menuButton.setAttribute('aria-expanded', String(active));
        menuButton.setAttribute('aria-label', active ? 'Close menu / Cerrar menú' : 'Open menu / Abrir menú');
        menuPanel.inert = phoneMenu ? !active : false;
        document.documentElement.classList.toggle('mobile-menu-open', active);
      }

      menuButton?.addEventListener('click', () => setMobileMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      menuPanel?.addEventListener('click', event => {
        if ((event.target as Element).closest('a, button[data-language], button[data-theme-toggle]')) {
          if ((event.target as Element).closest('a')) setMobileMenu(false);
        }
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
          setMobileMenu(false);
          menuButton.focus({ preventScroll: true });
        }
      });
      menuMedia.addEventListener('change', () => setMobileMenu(false));
      window.addEventListener('leo:close-menu', () => setMobileMenu(false));

      setMobileMenu(false);

      function protectVideos() {
        document.querySelectorAll<HTMLVideoElement>('video').forEach(video => {
          video.setAttribute('controlsList', 'nodownload');
          video.setAttribute('disablepictureinpicture', '');
          video.draggable = false;
        });
      }

      protectVideos();
      document.addEventListener('astro:page-load', protectVideos);
    </script>

    <ContactCard />
  </body>
</html>
