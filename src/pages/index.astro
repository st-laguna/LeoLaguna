---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeJourney from '../components/HomeJourney.astro';
import Projects from '../components/Projects.astro';
import ServicesIntro from '../components/ServicesIntro.astro';
import FeaturedWorks from '../components/FeaturedWorks.astro';
import Brands from '../components/Brands.astro';
import Footer from '../components/Footer.astro';
import '../styles/ipad-home.css';
import '../styles/compact-services.css';
import '../styles/unified-home.css';
import '../styles/progress-controls.css';
import '../styles/mobile-home.css';
---

<BaseLayout title="Leo Laguna — Scientific Illustrator & 3D Developer" description="Scientific illustration, 3D visualization and animation for marine research, conservation, aquaculture and engineering — by Leo Laguna.">
  <main>
    <HomeJourney />
    <div class="services-transition">
      <ServicesIntro />
      <Projects />
    </div>
    <div class="featured-brands" data-featured-brands>
      <section class="science-interlude" aria-label="Science and visual communication"><p><span class="science-desktop"><span class="science-line" data-i18n="science.1">Science is</span> <span class="science-line" data-i18n="science.2">complex.</span><br/><em><span class="science-line" data-i18n="science.3">Visuals</span> <span class="science-line" data-i18n="science.4">shouldn’t be.</span></em></span><span class="science-mobile"><span data-i18n="science.mobile.1">Science is</span><span data-i18n="science.mobile.2">Complex</span><em><span data-i18n="science.mobile.3">Visual</span><span data-i18n="science.mobile.4">shouldn’t be</span></em></span></p></section>
      <FeaturedWorks />
      <Brands />
      <div data-brands-footer-handoff><Footer /></div>
    </div>
  </main>
</BaseLayout>