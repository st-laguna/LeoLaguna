============================================================ -->
<script>
import { initWaterShader } from '../scripts/waterShader';
import { initParallax, destroyAnimations, initStickyCards } from "../scripts/parallax.js";
import { mountPlanktonParticles } from "../scripts/planktonParticles.ts";
import { initTextReveal } from "../scripts/textReveal.ts";
import { initServicesStack, destroyServicesStack } from "../scripts/servicesStack";
import { initSelectedWork, teardownSelectedWork } from '../scripts/selectedWork';
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

// ── Flags globales ──────────────────────────────────────────────

let programInterval: ReturnType<typeof setInterval> | null = null;
let clockInterval: ReturnType<typeof setInterval> | null = null;
let destroyPlankton: (() => void) | null = null;
let projectRowObservers: IntersectionObserver[] = [];

document.addEventListener("astro:page-load", async () => {

// ── Animaciones ─────────────────────────────────────────────

	destroyAnimations();
	initParallax();
	initTextReveal();
	initServicesStack();
	setTimeout(() => initSelectedWork(), 100);         // ← agregar esta línea


// ── Plankton ─────────────────────────────────────────────────

	destroyPlankton?.();
destroyPlankton = null;

const planktonSection = document.getElementById("plankton-section");

if (planktonSection) {
    destroyPlankton = mountPlanktonParticles(planktonSection);
}

// ── About panel ──────────────────────────────────────────────

	const panel   = document.getElementById("about-panel");
	const overlay = document.getElementById("panel-overlay");
	const closeBtn = document.getElementById("close-panel");

	if (panel && overlay && closeBtn) {
		document.querySelectorAll('a[href="/#about"]').forEach((link) => {
			link.addEventListener("click", (e) => {
				e.preventDefault();
				panel.classList.remove("translate-x-full");
				overlay.classList.remove("opacity-0", "pointer-events-none");
			});
		});
		closeBtn.addEventListener("click", () => {
			panel.classList.add("translate-x-full");
			overlay.classList.add("opacity-0", "pointer-events-none");
		});
		overlay.addEventListener("click", () => {
			panel.classList.add("translate-x-full");
			overlay.classList.add("opacity-0", "pointer-events-none");
		});
	}

// ── Cursor label (tools) ─────────────────────────────────────

	const cursorLabel = document.getElementById("cursor-label");

	if (cursorLabel) {
		document.addEventListener("mousemove", (e) => {
			cursorLabel.style.left = `${e.clientX + 14}px`;
			cursorLabel.style.top  = `${e.clientY - 10}px`;
		});
	}

// ── Water shader ─────────────────────────────────────────────

	const destroyWaterShader = initWaterShader();
document.addEventListener("astro:before-swap", destroyWaterShader, { once: true });

// ── Clock ────────────────────────────────────────────────────

	const clockTime = document.getElementById("clock-time");
	const clockDate = document.getElementById("clock-date");

	if (clockTime && clockDate) {
		const updateClock = () => {
			const now = new Date();
			clockTime.textContent = `Lima ${now.toLocaleTimeString("en-US", { timeZone: "America/Lima" })}`;
			clockDate.textContent  = now.toLocaleDateString("en-US", {
				weekday: "long", year: "numeric", month: "short", day: "numeric",
				timeZone: "America/Lima"
			});
		};
		updateClock();
		if (clockInterval) clearInterval(clockInterval);
		clockInterval = setInterval(updateClock, 1000);
	}

// end astro:page-load

document.addEventListener("astro:before-swap", () => {
    if (clockInterval) clearInterval(clockInterval);
    clockInterval = null;
    destroyPlankton?.();
    destroyPlankton = null;
    destroyServicesStack();
    teardownSelectedWork();      // ← agregar esta línea
});

// ── Text Scramble hover ──────────────────────────────────────

const chars = "▖▗▘◢◣◤◥▲▶▼◀▴▸▾◂◭◮◬◫◸◹◺◿⯅⯆⯇⯈ ▝▚▞▙▛▜▟◢◣◤◥▀▄▌▐▏▎█▁▂▃▄▅";

const FADE_DURATION = 150;   // debe coincidir con el transition del CSS
const OVERSHOOT = 1.15;       // la última letra se revela al 115% del fade

function scramble(el: HTMLElement) {
  const original = el.textContent ?? "";
  const len = original.length;
  let rafId: number | null = null;
  let startTime: number | null = null;
  let direction: "in" | "out" | null = null;
  let randomSnapshot: string[] = [];

  function randomChar() {
    return chars[Math.floor(Math.random() * chars.length)];
  }

  function clearAnim() {
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    startTime = null;
  }

  function tick(timestamp: number) {
    if (!startTime) startTime = timestamp;
    const elapsed = timestamp - startTime;
    const progress = Math.min(elapsed / (FADE_DURATION * OVERSHOOT), 1);

    // cuántas letras están reveladas según el progreso
    const revealed = Math.floor(progress * len);

    let output = "";

    if (direction === "in") {
      // cambia instantáneo a random, luego revela de izq a der
      for (let i = 0; i < len; i++) {
        if (original[i] === " ") {
          output += " ";
        } else if (i < revealed) {
          output += original[i];
        } else {
          output += randomSnapshot[i];
        }
      }
    } else {
      // revela de der a izq
      const scrambledFrom = len - revealed;
      for (let i = 0; i < len; i++) {
        if (original[i] === " ") {
          output += " ";
        } else if (i >= scrambledFrom) {
          output += original[i];
        } else {
          output += randomSnapshot[i];
        }
      }
    }

    el.textContent = output;

     if (progress < 1) {
      rafId = requestAnimationFrame(tick);
    } else {
      el.textContent = original;
      el.classList.remove("is-scrambling");
      rafId = null;
    }
  }
  function play() {
  clearAnim();
  direction = "in";
  el.classList.add("is-scrambling");
  randomSnapshot = Array.from(original).map(c => c === " " ? " " : randomChar());
  el.textContent = randomSnapshot.join("");
  rafId = requestAnimationFrame(tick);
}

  function cancel() {
  clearAnim();
  direction = "out";
  el.classList.add("is-scrambling");
  randomSnapshot = Array.from(original).map(c => c === " " ? " " : randomChar());
  el.textContent = randomSnapshot.join("");
  rafId = requestAnimationFrame(tick);
}

  return { play, cancel };
}

document.querySelectorAll<HTMLElement>(".nav-item span:first-child").forEach((el) => {
  const fx = scramble(el);
  const navItem = el.closest(".nav-item") as HTMLElement;
  navItem.addEventListener("mouseenter", () => fx.play());
  navItem.addEventListener("mouseleave", () => fx.cancel());
});

// ── Services explore label ───────────────────────────────────

let globalMouseX = 0;
let globalMouseY = 0;

window.addEventListener("mousemove", (e) => {
  globalMouseX = e.clientX;
  globalMouseY = e.clientY;
});

document.querySelectorAll<HTMLElement>(".services-item-media").forEach((media) => {
  const label = media.querySelector<HTMLElement>(".services-explore");
  if (!label) return;

  const updatePosition = () => {
    const rect = media.getBoundingClientRect();
    const isInside =
      globalMouseX >= rect.left &&
      globalMouseX <= rect.right &&
      globalMouseY >= rect.top &&
      globalMouseY <= rect.bottom;

    if (!isInside) return;

    const x = globalMouseX - rect.left;
    const y = globalMouseY - rect.top;
    label.style.left = `${x}px`;
    label.style.top  = `${y}px`;
  };

  media.addEventListener("mousemove", updatePosition);
  window.addEventListener("scroll", updatePosition, { passive: true });
}); // ← cierre del forEach

}); // ← cierre del astro:page-load
</script>