---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeJourney from '../components/HomeJourney.astro';
import Projects from '../components/Projects.astro';
import ServicesIntro from '../components/ServicesIntro.astro';
import FeaturedWorks from '../components/FeaturedWorks.astro';
import Brands from '../components/Brands.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Leo Laguna — Scientific Illustrator & 3D Developer" description="Scientific illustration, 3D visualization and animation for marine research, conservation, aquaculture and engineering — by Leo Laguna.">
  <main>
    <HomeJourney />
    <div class="services-transition">
      <ServicesIntro />
      <Projects />
    </div>
    <div class="featured-brands" data-featured-brands>
      <FeaturedWorks />
      <Brands />
    </div>
    <Footer />
  </main>
</BaseLayout>