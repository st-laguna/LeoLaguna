---
import AboutSection from '../components/about/AboutSection.astro';
import PageNavigation from '../components/PageNavigation.astro';
import '../styles/about.css';
---
<!doctype html>
<html lang="en" data-page="about">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About — Leo Laguna</title>
    <PageNavigation />
    <!-- Fetch the main actors during navigation; decode/scene creation waits for reveal. -->
    <link rel="preload" href="/about/models/leo.glb" as="fetch" crossorigin="anonymous" />
    <link rel="preload" href="/about/models/simba.glb" as="fetch" crossorigin="anonymous" />
    <link rel="preload" href="/about/models/morena.glb" as="fetch" crossorigin="anonymous" />
  </head>
  <body>
    <main data-page-content><AboutSection /></main>
    <script>import '../scripts/preferences';</script>
  </body>
</html>
