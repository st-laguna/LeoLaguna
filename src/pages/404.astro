---
// A top-level 404.html disables Cloudflare Pages' implicit SPA fallback.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — Leo Laguna</title>
    <style>body{margin:0;min-height:100svh;display:grid;place-content:center;background:#eee;color:#111;font-family:Arial,sans-serif;padding:0 24px}h1{font-size:clamp(48px,12vw,120px);margin:0}a{color:inherit}</style>
  </head>
  <body><main><h1>404</h1><p>Page not found / Página no encontrada.</p><a href="/">Home / Inicio</a></main></body>
</html>
