---
// Standalone experiment: deliberately imports no production layout or scripts.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>About · split test</title>
  </head>
  <body>
    <main id="split-test" data-open="false" data-settled="true" data-orientation="portrait">
      <header><span>ABOUT / LAB 01</span><h1>Five layers. One fracture.</h1></header>
      <div class="stage">
        <div class="phone-frame" aria-label="Mobile viewport prototype">
        <button class="artwork" type="button" aria-label="Open five anatomical layers" aria-expanded="false">
          <svg class="head-crop" viewBox="0 0 1200 1330" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <!-- Both polygons of each pair are derived from ONE boundary below.
                   crispEdges snaps the shared axis-aligned edge to device pixels. -->
              <clipPath id="split-top" clipPathUnits="userSpaceOnUse"><polygon shape-rendering="crispEdges" /></clipPath>
              <clipPath id="split-bottom" clipPathUnits="userSpaceOnUse"><polygon shape-rendering="crispEdges" /></clipPath>
              <clipPath id="split-left" clipPathUnits="userSpaceOnUse"><polygon shape-rendering="crispEdges" /></clipPath>
              <clipPath id="split-right" clipPathUnits="userSpaceOnUse"><polygon shape-rendering="crispEdges" /></clipPath>
              <linearGradient id="contact-down" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
              <linearGradient id="contact-up" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
              <linearGradient id="contact-right" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
              <linearGradient id="contact-left" x1="1" y1="0" x2="0" y2="0"><stop offset="0" stop-color="black" /><stop offset="1" stop-color="black" stop-opacity="0" /></linearGradient>
              {[1, 2, 3, 4].map(layer => (
                <mask id={`contact-alpha-${layer}`} maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="1330" style="mask-type: alpha">
                  <image data-shadow-source={layer} width="1200" height="1330" preserveAspectRatio="none" />
                </mask>
              ))}
            </defs>
            {/* SVG paints back to front: 5 deepest, 1 nearest. Timing runs 1 → 5. */}
            {[5, 4, 3, 2, 1].map(layer => (
              <g class="layer" data-layer={layer} data-settled="true" style={`--layer-index: ${layer - 1}`}>
                <g class="piece first"><image width="1200" height="1330" preserveAspectRatio="none" />
                  {layer < 5 && <g class="contact-shadow" mask={`url(#contact-alpha-${layer})`} aria-hidden="true"><g class="contact-portrait" /><g class="contact-landscape" /></g>}
                </g>
                <g class="piece second"><image width="1200" height="1330" preserveAspectRatio="none" />
                  {layer < 5 && <g class="contact-shadow" mask={`url(#contact-alpha-${layer})`} aria-hidden="true"><g class="contact-portrait" /><g class="contact-landscape" /></g>}
                </g>
              </g>
            ))}
          </svg>
        </button>
        <section class="card-placeholder" aria-hidden="true">
          <span>ABOUT / COMPOSITION TEST</span>
          <h2>Space for the story.</h2>
          <p>Temporary card · layout only</p>
        </section>
        </div>
      </div>
      <footer>
        <div class="controls" aria-label="Prototype controls">
          <button id="toggle" type="button" aria-expanded="false">Open</button>
          <div role="group" aria-label="Split orientation">
            <button type="button" data-mode="portrait" aria-pressed="true">Portrait</button>
            <button type="button" data-mode="landscape" aria-pressed="false">Landscape</button>
            <button type="button" data-mode="auto" aria-pressed="true">Auto</button>
          </div>
        </div>
        <p id="status" role="status">Closed · tap the image to open</p>
      </footer>
    </main>
    <style>
      /* TUNING — split-unit is in the 1200 × 1330 source coordinate system.
         It is read once on load: edit then reload (never animated).
         distance is travel PER HALF, relative to the artwork's SVG viewport. */
      #split-test {
        /* FRAME / FIXED CROP — scale is relative to the frame's short side.
           Crop anchors are percentages of the source image; offsets of the frame.
           These do NOT depend on open/closed state. */
        --portrait-head-scale: 2.8;
        --portrait-head-x: 0%;
        --portrait-head-y: -12%;
        --portrait-crop-x: 50.666667%; /* source x = 608 */
        --portrait-crop-y: 31.278195%; /* source y = 416, horizontal fracture */
        --landscape-head-scale: 2;
        --landscape-head-x: 0%;
        --landscape-head-y: 0%;
        --landscape-crop-x: 50.666667%;
        --landscape-crop-y: 46.616541%; /* source y = 620, facial region */
        --portrait-gap: .58; /* Fraction of usable frame height. */
        /* Equal additive offsets preserve the gap and manual layer spacing. */
        --portrait-upper-opening-adjustment: calc(var(--split-distance-portrait) * .414);
        --portrait-lower-opening-adjustment: calc(var(--split-distance-portrait) * .414);
        --landscape-gap: .64; /* Fraction of usable frame width. */
        --portrait-card-width: 84%;
        --portrait-card-height: 46%;
        --landscape-card-width: 56%;
        --landscape-card-height: 76%;
        /* Source-unit travel computed on frame resize; no animation loop. */
        --split-distance-portrait: 0px;
        --split-distance-landscape: 0px;
        /* Multipliers of base distance, NOT extra viewport percentage points. */
        --layer-1-distance: 1;
        --layer-2-distance: 1.10;
        --layer-3-distance: 1.10;
        --layer-4-distance: 1.10;
        --layer-5-distance: 1.10;
        --split-duration-open: 480ms;
        --split-duration-close: 560ms;
        --split-duration: var(--split-duration-close);
        --split-easing-open: cubic-bezier(.76, 0, .24, 1); /* Slow launch, decisive middle, soft stop. */
        --split-easing-close: cubic-bezier(.72, 0, .18, 1); /* Slow launch and a longer settling tail. */
        --split-easing: var(--split-easing-close);
        --split-stagger: .45; /* Start interval = duration × .45; 55% temporal overlap. */
        --contact-shadow-opacity: .16; /* Set 0 to disable. */
        --contact-shadow-depth-fade: .015;
        --contact-shadow-softness: 10px; /* Static gradient width, source units; reload after editing. */
        --contact-shadow-offset: 2px; /* Inset from fracture, source units; reload after editing. */
        --split-unit: 8px;
        min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto;
        color: #ecece7; background: #1c1c1c; font-family: system-ui, sans-serif;
      }
      :global(body) { margin: 0; }
      #split-test[data-open="true"] { --split-easing: var(--split-easing-open); --split-duration: var(--split-duration-open); }
      .contact-shadow { pointer-events: none; opacity: max(0, calc(var(--contact-shadow-opacity) - var(--layer-index) * var(--contact-shadow-depth-fade))); }
      .contact-landscape { display: none; }
      [data-orientation="landscape"] .contact-portrait { display: none; }
      [data-orientation="landscape"] .contact-landscape { display: inline; }
      #split-test[data-settled="true"] .contact-shadow { visibility: hidden; }
      header { padding: 24px 28px 0; }
      header span { font: 10px monospace; letter-spacing: .16em; color: #9ca59c; }
      h1 { font-size: 18px; font-weight: 450; margin: 8px 0 0; }
      .stage { display: grid; place-items: center; padding: 24px 16px; }
      button { font: inherit; cursor: pointer; touch-action: manipulation; }
      .phone-frame {
        --head-scale: var(--portrait-head-scale);
        --head-x: var(--portrait-head-x); --head-y: var(--portrait-head-y);
        --crop-x: var(--portrait-crop-x); --crop-y: var(--portrait-crop-y);
        position: relative; container-type: size; isolation: isolate;
        width: min(390px, calc(100vw - 32px), calc((100svh - 190px) * 390 / 844));
        aspect-ratio: 390 / 844; overflow: hidden; outline: 1px solid #555d55;
        background: #809db6;
      }
      [data-orientation="landscape"] .phone-frame {
        --head-scale: var(--landscape-head-scale);
        --head-x: var(--landscape-head-x); --head-y: var(--landscape-head-y);
        --crop-x: var(--landscape-crop-x); --crop-y: var(--landscape-crop-y);
        width: min(844px, calc(100vw - 32px), calc((100svh - 190px) * 844 / 390));
        aspect-ratio: 844 / 390;
      }
      .artwork { position: absolute; inset: 0; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; color: inherit; -webkit-tap-highlight-color: transparent; }
      .head-crop { position: absolute; display: block; width: calc(100cqw * var(--head-scale)); height: auto; overflow: visible;
        left: calc(50% + var(--head-x)); top: calc(50% + var(--head-y));
        transform: translate(calc(-1 * var(--crop-x)), calc(-1 * var(--crop-y))); }
      [data-orientation="landscape"] .head-crop { width: calc(100cqh * var(--head-scale)); }
      .card-placeholder { position: absolute; box-sizing: border-box; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: var(--portrait-card-width); height: var(--portrait-card-height); padding: 20px;
        display: flex; flex-direction: column; justify-content: center;
        border: 1px solid #848d7f; background: #dce2d3; color: #242a24;
        opacity: 0; visibility: hidden; pointer-events: none; }
      [data-orientation="landscape"] .card-placeholder { width: var(--landscape-card-width); height: var(--landscape-card-height); }
      [data-open="true"][aria-busy="false"] .card-placeholder { opacity: 1; visibility: visible; transition: opacity 160ms ease-out; }
      .card-placeholder span, .card-placeholder p { font: 10px/1.5 monospace; }
      .card-placeholder h2 { font-size: clamp(16px, 5cqw, 26px); font-weight: 450; margin: 12px 0; }
      image { image-rendering: pixelated; }
      /* SVG paint order above is the stacking order: 1 covers 2, then 3, 4, 5.
         Every layer shares the same origin; depth displacement exists ONLY open. */
      .layer[data-layer="1"] { --distance-factor: var(--layer-1-distance); }
      .layer[data-layer="2"] { --distance-factor: var(--layer-2-distance); }
      .layer[data-layer="3"] { --distance-factor: var(--layer-3-distance); }
      .layer[data-layer="4"] { --distance-factor: var(--layer-4-distance); }
      .layer[data-layer="5"] { --distance-factor: var(--layer-5-distance); }
      .layer { --travel: calc(var(--split-distance-portrait) * var(--distance-factor)); --sequence-index: calc(4 - var(--layer-index)); }
      [data-open="true"] .layer { --sequence-index: var(--layer-index); }
      [data-orientation="landscape"] .layer { --travel: calc(var(--split-distance-landscape) * var(--distance-factor)); }
      .piece { transform-box: view-box; transition: transform var(--split-duration) var(--split-easing); transition-delay: calc(var(--sequence-index) * var(--split-duration) * var(--split-stagger)); }
      .first image { clip-path: url(#split-top); }
      .second image { clip-path: url(#split-bottom); }
      [data-orientation="landscape"] .first image { clip-path: url(#split-left); }
      [data-orientation="landscape"] .second image { clip-path: url(#split-right); }
      /* At rest reuse the first image uncut. This avoids fractional-pixel alpha
         compositing seams without overlaps, extra assets, or a third image. */
      #split-test[data-settled="true"] .first image { clip-path: none; }
      #split-test[data-settled="true"] .second { visibility: hidden; }
      [data-open="true"][data-orientation="portrait"] .first { transform: translateY(calc(-1 * var(--travel) + var(--portrait-upper-opening-adjustment))); }
      [data-open="true"][data-orientation="portrait"] .second { transform: translateY(calc(var(--travel) + var(--portrait-lower-opening-adjustment))); }
      [data-open="true"][data-orientation="landscape"] .first { transform: translateX(calc(-1 * var(--travel))); }
      [data-open="true"][data-orientation="landscape"] .second { transform: translateX(var(--travel)); }
      footer { text-align: center; padding: 0 16px 22px; }
      .controls, .controls div { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; }
      .controls { gap: 16px; }
      .controls button { background: transparent; border: 1px solid #555d55; border-radius: 5px; color: inherit; padding: 9px 12px; font-size: 12px; }
      .controls button[aria-pressed="true"], #toggle { background: #e4e8dc; color: #1e241e; }
      button:focus-visible { outline: 2px solid #c3ed8c; outline-offset: 5px; }
      #status { font: 10px monospace; color: #a7afa6; margin: 13px 0 0; }
      @media (prefers-reduced-motion: reduce) { .piece { transition-duration: 0ms; transition-delay: 0ms; } }
      #split-test[data-finishing="true"] .piece { transition: none; }
      button[aria-disabled="true"], button:disabled { cursor: progress; }
    </style>
    <script>
      const root = document.querySelector<HTMLElement>('#split-test')!;
      const art = root.querySelector<HTMLButtonElement>('.artwork')!;
      const toggle = root.querySelector<HTMLButtonElement>('#toggle')!;
      const status = root.querySelector<HTMLElement>('#status')!;
      const modeButtons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
      const frame = root.querySelector<HTMLElement>('.phone-frame')!;
      const head = root.querySelector<SVGSVGElement>('.head-crop')!;
      const card = root.querySelector<HTMLElement>('.card-placeholder')!;
      const layers = Array.from(root.querySelectorAll<SVGGElement>('.layer'));
      const unit = parseFloat(getComputedStyle(root).getPropertyValue('--split-unit')) || 8;
      const W = 1200, H = 1330;
      type Point = [number, number];
      // FRACTURE COORDINATES: [end position in source units, signed step multiplier].
      // Long zero plateaus separate six quiet ±1 notches. No aggressive ±2 steps.
      // Horizontal baseline 416: forehead above glasses; vertical baseline 608: nose.
      const portraitRuns: Point[] = [
        [240,0],[272,1],[368,0],[400,-1],[512,0],[544,1],
        [656,0],[688,-1],[800,0],[832,1],[944,0],[976,-1],[1200,0],
      ];
      const landscapeRuns: Point[] = [
        [208,0],[240,1],[368,0],[400,-1],[528,0],[560,1],
        [704,0],[736,-1],[880,0],[912,1],[1056,0],[1088,-1],[1330,0],
      ];
      function boundary(runs: Point[], baseline: number, vertical: boolean): Point[] {
        let start = 0;
        return runs.flatMap(([end, offset]) => {
          const cross = baseline + offset * unit;
          const pair: Point[] = vertical ? [[cross,start],[cross,end]] : [[start,cross],[end,cross]];
          start = end;
          return pair;
        });
      }
      function polygon(id: string, points: Point[]) {
        root.querySelector(`#${id} polygon`)!.setAttribute('points', points.map(p => p.join(',')).join(' '));
      }
      const horizontal = boundary(portraitRuns, 416, false);
      const vertical = boundary(landscapeRuns, 608, true);
      polygon('split-top', [[0,0],[W,0], ...horizontal.slice().reverse()]);
      polygon('split-bottom', [...horizontal, [W,H],[0,H]]);
      polygon('split-left', [[0,0], ...vertical, [0,H]]);
      polygon('split-right', [[W,0],[W,H], ...vertical.slice().reverse()]);
      // Static contact-rim approximation on each overlapping layer (1–4). Source alpha
      // preserves transparent dither holes. No blur, filter, or per-frame JS.
      // The existing fracture arrays and all piece transforms remain untouched.
      const shadowStyle = getComputedStyle(root);
      const softness = Math.max(0, parseFloat(shadowStyle.getPropertyValue('--contact-shadow-softness')) || 0);
      const inset = Math.max(0, parseFloat(shadowStyle.getPropertyValue('--contact-shadow-offset')) || 0);
      root.querySelectorAll<SVGGElement>('.contact-shadow').forEach(shadow => {
        const first = shadow.parentElement!.classList.contains('first');
        for (const landscape of [false, true]) {
          const runs = landscape ? landscapeRuns : portraitRuns;
          const target = shadow.querySelector(landscape ? '.contact-landscape' : '.contact-portrait')!;
          let start = 0;
          runs.forEach(([end, step]) => {
            const edge = (landscape ? 608 : 416) + step * unit;
            const cross = first ? edge - inset - softness : edge + inset;
            const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            const attrs = { x: landscape ? cross : start, y: landscape ? start : cross,
              width: landscape ? softness : end - start, height: landscape ? end - start : softness };
            Object.entries(attrs).forEach(([key, value]) => rect.setAttribute(key, String(value)));
            rect.setAttribute('fill', `url(#contact-${landscape ? (first ? 'left' : 'right') : (first ? 'up' : 'down')})`);
            target.append(rect);
            start = end;
          });
        }
      });
      const orientation = matchMedia('(orientation: portrait)');
      // Short-side threshold keeps rotated phones on the mobile asset.
      const tablet = matchMedia('(min-width: 768px) and (min-height: 600px)');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const settleTimers = new Map<SVGGElement, ReturnType<typeof setTimeout>>();
      let busy = false;
      let unlockTimer: ReturnType<typeof setTimeout>;
      let mode = 'auto';
      function syncOrientation() {
        if (busy) return; // Apply the latest viewport orientation after the cascade.
        root.dataset.orientation = mode === 'auto' ? (orientation.matches ? 'portrait' : 'landscape') : mode;
        syncComposition();
        modeButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
        updateStatus();
      }
      function updateStatus() {
        const state = busy ? (root.dataset.open === 'true' ? 'Opening…' : 'Closing…') : (root.dataset.open === 'true' ? 'Open' : 'Closed');
        status.textContent = `${state} · ${root.dataset.orientation} · 5 ${tablet.matches ? 'iPad' : 'mobile'} layers`;
      }
      function syncAsset() {
        if (busy) return;
        layers.forEach(layer => {
          const url = `/about/img/${tablet.matches ? 'ipad' : 'mobile'}/${layer.dataset.layer}.webp`;
          layer.querySelectorAll('image').forEach(img => img.setAttribute('href', url));
          root.querySelector(`[data-shadow-source="${layer.dataset.layer}"]`)?.setAttribute('href', url);
        });
        updateStatus();
      }
      function toggleOpen() {
        if (busy) return; // Drop repeated clicks/taps/keyboard activation; never queue them.
        busy = true;
        root.setAttribute('aria-busy', 'true');
        art.setAttribute('aria-disabled', 'true');
        toggle.setAttribute('aria-disabled', 'true');
        modeButtons.forEach(button => { button.disabled = true; });
        const open = root.dataset.open !== 'true';
        settleTimers.forEach(timer => clearTimeout(timer));
        settleTimers.clear();
        layers.forEach(layer => { layer.dataset.settled = 'false'; });
        root.dataset.settled = 'false';
        root.dataset.open = String(open);
        card.setAttribute('aria-hidden', 'true');
        if (!open) {
          layers.forEach(layer => {
            const style = getComputedStyle(layer.querySelector('.first')!);
            const milliseconds = (value: string) => parseFloat(value) * (value.endsWith('ms') ? 1 : 1000);
            const total = milliseconds(style.transitionDuration) + milliseconds(style.transitionDelay);
            // Per-layer fallback includes its delay, including interrupted reversals.
            settleTimers.set(layer, setTimeout(() => {
              settleLayer(layer);
              settleTimers.delete(layer);
            }, reducedMotion.matches ? 0 : total + 34));
          });
        }
        art.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-expanded', String(open));
        art.setAttribute('aria-label', `${open ? 'Close' : 'Open'} five anatomical layers`);
        toggle.textContent = open ? 'Close' : 'Open';
        // One bounded timer per accepted action. Include every layer's delay;
        // do not depend on transitionend (absent with reduced motion/hidden tabs).
        const milliseconds = (value: string) => parseFloat(value) * (value.endsWith('ms') ? 1 : 1000);
        const total = Math.max(...layers.map(layer => {
          const style = getComputedStyle(layer.querySelector('.piece')!);
          return milliseconds(style.transitionDuration) + milliseconds(style.transitionDelay);
        }));
        clearTimeout(unlockTimer);
        unlockTimer = setTimeout(finishInteraction, total > 0 ? total + 50 : 0);
        updateStatus();
      }
      function finishInteraction() {
        if (!busy) return;
        clearTimeout(unlockTimer);
        settleTimers.forEach(timer => clearTimeout(timer));
        settleTimers.clear();
        // Also settle safely if the tab was hidden or reduced motion changed.
        root.dataset.finishing = 'true';
        const closed = root.dataset.open === 'false';
        layers.forEach(layer => { layer.dataset.settled = String(closed); });
        root.dataset.settled = String(closed);
        busy = false;
        syncOrientation();
        syncAsset();
        // Commit a deferred orientation without starting a second animation.
        root.getBoundingClientRect();
        delete root.dataset.finishing;
        root.setAttribute('aria-busy', 'false');
        card.setAttribute('aria-hidden', String(closed));
        art.setAttribute('aria-disabled', 'false');
        toggle.setAttribute('aria-disabled', 'false');
        modeButtons.forEach(button => { button.disabled = false; });
      }
      art.addEventListener('click', toggleOpen);
      [art, toggle].forEach(button => button.addEventListener('keydown', event => {
        if (event.repeat && (event.key === 'Enter' || event.key === ' ')) event.preventDefault();
      }));
      reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) finishInteraction(); });
      document.addEventListener('visibilitychange', () => { if (document.hidden) finishInteraction(); });
      function settleLayer(layer: SVGGElement) {
        layer.dataset.settled = 'true';
        if (root.dataset.open === 'false' && layers.every(item => item.dataset.settled === 'true')) {
          root.dataset.settled = 'true';
        }
      }
      art.addEventListener('transitionend', (event) => {
        if (event.propertyName === 'transform' && root.dataset.open === 'false' && (event.target as Element).matches('.piece.first')) {
          const layer = (event.target as Element).closest<SVGGElement>('.layer')!;
          clearTimeout(settleTimers.get(layer));
          settleTimers.delete(layer);
          settleLayer(layer);
        }
      });
      toggle.addEventListener('click', toggleOpen);
      modeButtons.forEach(button => button.addEventListener('click', () => {
        mode = button.dataset.mode!;
        syncOrientation();
      }));
      orientation.addEventListener('change', syncOrientation);
      tablet.addEventListener('change', syncAsset);
      function syncComposition() {
        if (busy) return;
        const size = frame.getBoundingClientRect();
        const scale = head.getBoundingClientRect().width / W;
        if (!scale || !size.height) return;
        const style = getComputedStyle(root);
        // half travel (source units) = desired screen gap / 2 / fixed source scale.
        // Manual layer multipliers are applied unchanged by .layer's --travel.
        const portrait = size.height * parseFloat(style.getPropertyValue('--portrait-gap')) / (2 * scale);
        const landscape = size.width * parseFloat(style.getPropertyValue('--landscape-gap')) / (2 * scale);
        root.style.setProperty('--split-distance-portrait', `${portrait}px`);
        root.style.setProperty('--split-distance-landscape', `${landscape}px`);
      }
      // Observes sizing only, never animated transforms. No continuous RAF.
      const compositionObserver = new ResizeObserver(syncComposition);
      compositionObserver.observe(frame);
      compositionObserver.observe(head);
      syncOrientation();
      syncAsset();
    </script>
  </body>
</html>


